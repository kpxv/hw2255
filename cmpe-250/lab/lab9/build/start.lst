   1              	// ****************************************************************
   2              	// * Flash configuration image for area at 0x400-0x40F(+)
   3              	// * SystemInit subroutine (++)
   4              	// * SetClock48MHz subroutine (+, +++)
   5              	// +:Following [3]
   6              	// ++:Following [1].1.1.4.2 Startup routines and [2]
   7              	// +++:Following [1].4.1 Clocking
   8              	// [1] Freescale Semiconductor, <B>Kinetis L Peripheral Module Quick
   9              	//     Reference</B>, KLQRUG, Rev. 0, 9/2012.
  10              	// [2] Freescale Semiconductor, <B>KL05 Sub-Family Reference Manual</B>,
  11              	//     KL05P48M48SF1RM, Rev. 3.1, 11/2012.
  12              	// [3] Freescale startup_MKL05Z4.s and system_MKL05Z4.c
  13              	//     Device specific configuration file for MKL05Z4
  14              	//     rev. 2.2, 4/12/2013
  15              	// [4] RIT CMPE-250 KL46 Bare Metal Assembly Startup, 2/5/2018
  16              	// Name:  R. W. Melton
  17              	// Date:  January 13, 2025
  18              	// Class:  CMPE 250
  19              	// Section:  All sections
  20              	// ****************************************************************
  21              	// Assembler Directives
  22              	.title "KL05 Bare Metal Assembly Startup"
  23              	.syntax unified
  24              	.thumb
  25              	// ****************************************************************
  26              	// Include files
  27              	//   MKL05Z4.s
  30              	.list
  31              	// ****************************************************************
  32              	// EQUates
  33              	// ---------------------------------------------------------------
  34              	// Clock source values
  35              	// External crystal frequency (Hz)
  36              	.set CPU_XTAL_CLK_HZ       ,  32768
  37              	// Slow internal oscillator frequency (Hz)
  38              	.set CPU_INT_SLOW_CLK_HZ   ,  32768
  39              	// Fast internal oscillator frequency (Hz)
  40              	.set CPU_INT_FAST_CLK_HZ   ,  4000000
  41              	// Default system clock frequency (Hz)
  42              	.set DEFAULT_SYSTEM_CLOCK  ,  47972352
  43              	// ---------------------------------------------------------------
  44              	// MCG_C1 MCG Control 1 Register
  45              	//  00-->7-6:CLKS=clock source select (FLL)
  46              	// 000-->5-3:FRDIV=FLL external reference divider (1 for LF range)
  47              	//   0-->  2:IREFS=internal reference select (for FLL) (external)
  48              	//   1-->  1:IRCLKEN=internal reference clock (MCGIRCLK) enable
  49              	//   0-->  0:IREFSTEN=internal reference stop enable
  50              	.set MCG_C1_FLL_DIV1_IRCLKEXTSTOP  ,  MCG_C1_IRCLKEN_MASK
  51              	// ---------------------------------------------------------------
  52              	// MCG_C2 MCG Control 2 Register 
  53              	//  0-->  7:LOCRE0=loss of clock reset enable (interrupt, not reset)
  54              	// 00-->5-4:RANGE0=frequency range select (low frequency)
  55              	//  0-->  3:HGO0=high gain oscillator select (low-power)
  56              	//  1-->  2:EREFS0=external reference select (oscillator)
  57              	//  0-->  1:LP=low power select (FLL not disabled in bypass)
  58              	//  0-->  0:IRCS=internal reference clock select (slow)
  59              	.set MCG_C2_LF_EREFOSC  ,  MCG_C2_EREFS0_MASK
  60              	// ---------------------------------------------------------------
  61              	// MCG_C4 MCG Control 4 Register
  62              	//   1-->   7:DMX32=DCO maximum frequency with 32.768 kHz ref
  63              	//                 (25%)
  64              	//   01-->6-5:DRST_DRS=DCO range select (mid range)
  65              	// keep-->4-1:FCTRIM=fast internal reference clock trim setting
  66              	// keep-->  0:SCFTRIM=slow internal reference clock fine trim
  67              	.set MCG_C4_DCO_25PMAX_MID  ,  (MCG_C4_DMX32_MASK | (1 << MCG_C4_DRST_DRS_SHIFT))
  68              	// ---------------------------------------------------------------
  69              	// Port A
  70              	.set PORT_PCR_SET_PTA3_EXTAL  ,  (PORT_PCR_ISF_MASK | PORT_PCR_MUX_SELECT_0_MASK)
  71              	.set PORT_PCR_SET_PTA4_XTAL   ,  (PORT_PCR_ISF_MASK | PORT_PCR_MUX_SELECT_0_MASK)
  72              	// ---------------------------------------------------------------
  73              	// OSC0_CR
  74              	// 1-->7:ERCLKEN=external reference enable
  75              	// 0-->5:EREFSTEN=external reference stop enable
  76              	// 0-->3:SC2P=oscillator 2-pF capacitor load configure (disabled)
  77              	// 0-->2:SC4P=oscillator 4-pF capacitor load configure (disabled)
  78              	// 0-->1:SC8P=oscillator 8-pF capacitor load configure (disabled)
  79              	// 0-->0:SC16P=oscillator 16-pF capacitor load configure (disabled)
  80              	.set OSC0_CR_ERCLK_STOP_NOLOAD  , OSC_CR_ERCLKEN_MASK
  81              	// ---------------------------------------------------------------
  82              	// SIM_CLKDIV1
  83              	// 0000-->31-28:OUTDIV1=clock 1 output divider value (1)
  84              	//              :set divider for core/system clock,
  85              	//              :from which bus/flash clocks are derived
  86              	//              :divide by OUTDIV1 + 1
  87              	// 001-->18-16:OUTDIV4=clock 4 output divider value (2)
  88              	//              :sets divider for bus and flash clocks,
  89              	//              :relative to core/system clock
  90              	//              :divide by OUTDIV4 + 1
  91              	.set SIM_CLKDIV1_COREDIV1_BUSDIV2  ,  (1 << SIM_CLKDIV1_OUTDIV4_SHIFT)
  92              	// ---------------------------------------------------------------
  93              	// SIM_COPC
  94              	// 00-->3-2:COPT=COP watchdog timeout (disabled)
  95              	//  0-->  1:COPCLKS=COP clock select (x)
  96              	//  0-->  0:COPW=COP windowed mode (x)
  97              	.set SIM_COPC_COP_DISABLED  ,  0
  98              	// ****************************************************************
  99              	.section start, "ax"
 100              	.global Startup
 101              	// ---------------------------------------------------------------
 102              	Startup:     
 103              	// ****************************************************************
 104              	// Performs the following startup tasks
 105              	// * System initialization
 106              	// * Mask interrupts
 107              	// * Configure 48-MHz system clock
 108              	// Calls:  SystemInit
 109              	//         SetClock48MHz
 110              	// Input:  None
 111              	// Output:  None
 112              	// Modifies:  R0-R15;APSR
 113              	// ****************************************************************
 114              	// Save return address
 115 0000 00B5     	            PUSH    {LR}
 116              	// Initialize system
 117 0002 00F004F8 	            BL      SystemInit
 118              	// Mask interrupts
 119 0006 72B6     	            CPSID   I
 120              	// Configure 48-MHz system clock
 121 0008 00F020F8 	            BL      SetClock48MHz
 122              	// Return
 123 000c 00BD     	            POP     {PC}
 124              	                // Startup
 125              	// ---------------------------------------------------------------
 126              	SystemInit:  
 127              	// ****************************************************************
 128              	// Performs the following system initialization tasks.
 129              	// * Mask interrupts
 130              	// * Disable watchdog timer (+)
 131              	// * Initialize registers to known state for debugger
 132              	// +:Following [1].1.1.4.2 Startup routines: 1 Disable watchdog
 133              	// [1] Freescale Semiconductor, <B>Kinetis L Peripheral Module Quick
 134              	//     Reference</B>, KLQRUG, Rev. 0, 9/2012.
 135              	// Input:  None
 136              	// Output:  None
 137              	// Modifies:  R0-R15;APSR
 138              	// ****************************************************************
 139              	// Mask interrupts
 140 000e 72B6     	            CPSID   I
 141              	// Disable COP watchdog timer
 142 0010 2548     	            LDR     R0,=SIM_COPC
 143 0012 0021     	            MOVS    R1,#SIM_COPC_COP_DISABLED
 144 0014 0160     	            STR     R1,[R0,#0]
 145              	// Put return address on stack
 146 0016 00B5     	            PUSH    {LR}
 147              	// Initialize registers
 148 0018 4FF01131 	            LDR     R1,=0x11111111
 149 001c 4A18     	            ADDS    R2,R1,R1
 150 001e 5318     	            ADDS    R3,R2,R1
 151 0020 5C18     	            ADDS    R4,R3,R1
 152 0022 6518     	            ADDS    R5,R4,R1
 153 0024 6E18     	            ADDS    R6,R5,R1
 154 0026 7718     	            ADDS    R7,R6,R1
 155 0028 8846     	            MOV     R8,R1
 156 002a B844     	            ADD     R8,R8,R7
 157 002c 8946     	            MOV     R9,R1
 158 002e C144     	            ADD     R9,R9,R8
 159 0030 8A46     	            MOV     R10,R1
 160 0032 CA44     	            ADD     R10,R10,R9
 161 0034 8B46     	            MOV     R11,R1
 162 0036 D344     	            ADD     R11,R11,R10
 163 0038 8C46     	            MOV     R12,R1
 164 003a DC44     	            ADD     R12,R12,R11
 165 003c 9646     	            MOV     R14,R2
 166 003e E644     	            ADD     R14,R14,R12
 167 0040 0846     	            MOV     R0,R1
 168 0042 7044     	            ADD     R0,R0,R14
 169 0044 80F30088 	            MSR     APSR,R0
 170 0048 1848     	            LDR     R0,=0x05250113
 171 004a 00BD     	            POP     {PC}
 172              	                // SystemInit
 173              	// ---------------------------------------------------------------
 174              	SetClock48MHz:  
 175              	// ****************************************************************
 176              	// Multipurpose clock generator (MCG) in FLL engaged external (FEE) mode
 177              	// Establishes 48-MHz FLL clock from 32.678-kHz external crystal
 178              	// Core clock = 47.97MHz
 179              	// BusClock = 23.98MHz
 180              	// Corresponds to CLOCK_SETUP = 1 in system_MKL05Z4.c
 181              	// Follows [3], [2].24.5.1 MCG module initialization sequence,
 182              	//   and [1].4.1 Clocking 3: Configuration examples,
 183              	// [1] Freescale Semiconductor, <B>Kinetis L Peripheral Module Quick
 184              	//     Reference</B>, KLQRUG, Rev. 0, 9/2012.
 185              	// [2] Freescale Semiconductor, <B>KL05 Sub-Family Reference Manual</B>,
 186              	//     KL05P48M48SF1RM, Rev. 3.1, 11/2012.
 187              	// [3] Freescale startup_MKL05Z4.s and system_MKL05Z4.c
 188              	//     rev. 1.6, 4/11/2013
 189              	// Input:  None
 190              	// Output:  None
 191              	// Modifies:  APSR
 192              	// ****************************************************************
 193 004c 0FB4     	            PUSH    {R0-R3}
 194              	// Configure for external clock from external 32-kHz oscillator
 195              	//   EXTAL0 on PTA3
 196              	//   XTAL0 on PTA4
 197              	            // Enable PORT A
 198 004e 1848     	            LDR      R0,=SIM_SCGC5
 199 0050 4FF40071 	            LDR      R1,=SIM_SCGC5_PORTA_MASK
 200 0054 0268     	            LDR      R2,[R0,#0]
 201 0056 0A43     	            ORRS     R2,R2,R1
 202 0058 0260     	            STR      R2,[R0,#0]
 203              	            // Set PORT A Pin 3 for EXTAL0
 204 005a 1648     	            LDR      R0,=PORTA_BASE
 205 005c 4FF08071 	            LDR      R1,=PORT_PCR_SET_PTA3_EXTAL
 206 0060 C160     	            STR      R1,[R0,#PORTA_PCR3_OFFSET]
 207              	            // Set PORT A Pin 4 for XTAL0
 208              	            // PORT_PCR_SET same as PTA3 already in R1
 209              	            // LDR     R1,=PORT_PCR_SET_PTA4_EXTAL
 210 0062 0161     	            STR      R1,[R0,#PORTA_PCR4_OFFSET]
 211              	// Update clock dividers:  system/core = 1; bus/flash = 2
 212              	// [1] defers this step until first part of switching to FEE mode
 213 0064 1448     	            LDR      R0,=SIM_CLKDIV1
 214 0066 4FF48031 	            LDR      R1,=SIM_CLKDIV1_COREDIV1_BUSDIV2
 215 006a 0160     	            STR      R1,[R0,#0]
 216              	// ------------------------------------------
 217              	// Establish FLL engaged external mode (FEE)
 218              	// ------------------------------------------
 219              	// First configure oscillator settings in MCG_C2
 220              	//   RANGE is determined from external frequency
 221              	//   Since RANGE affects FRDIV, it must be set
 222              	//   correctly even with an external clock
 223              	//   * Low frequency range
 224              	//   * External reference oscillator
 225 006c 1348     	            LDR     R0,=MCG_BASE
 226 006e 0421     	            MOVS    R1,#MCG_C2_LF_EREFOSC
 227 0070 4170     	            STRB    R1,[R0,#MCG_C2_OFFSET]
 228              	// Enable external reference clock OSCERCLK,
 229              	// without additional oscillator load
 230 0072 134A     	            LDR     R2,=OSC0_CR
 231 0074 8021     	            MOVS    R1,#OSC0_CR_ERCLK_STOP_NOLOAD
 232 0076 1170     	            STRB    R1,[R2,#0]
 233              	// FRDIV set to keep FLL ref clock within
 234              	// correct range, determined by ref clock.
 235              	//   For 1-KHz ref, need divide by 1 (FRDIV = 0)
 236              	//   CLKS must be set to 2_00 to select FLL
 237              	//   Clearing IREFS selects and enables
 238              	//     external oscillator
 239              	//   [3] sets IRCLKEN for internal reference clock as MCGIRCLK
 240              	//   [2] states this is optional:  convenient to allow
 241              	//       switching between internal and external but
 242              	//       consumes more power
 243 0078 0221     	            MOVS    R1,#MCG_C1_FLL_DIV1_IRCLKEXTSTOP
 244 007a 0170     	            STRB    R1,[R0,#MCG_C1_OFFSET]
 245              	// Wait for oscillator initialization cycles
 246              	// to complete and become stable
 247              	// [2] suggests doing this step here
 248              	// [3] omits this step
 249 007c 0221     	            MOVS    R1,#MCG_S_OSCINIT0_MASK
 250              	SetClock48MHz_Wait_MCG_S_OSCINIT0:                      // repeat {
 251 007e 8279     	            LDRB    R2,[R0,#MCG_S_OFFSET]
 252 0080 1142     	            TST     R1,R2
 253 0082 FCD0     	            BEQ     SetClock48MHz_Wait_MCG_S_OSCINIT0  // } until OSCINIT0
 254              	// Wait for source of the FLL reference clock 
 255              	// to be the external reference clock.
 256              	// [2] suggests doing this step here
 257              	// [3] defers until after MCG_C4 initialization
 258              	// (MCG_S:  IREFST becomes 0)
 259 0084 1021     	            MOVS    R1,#MCG_S_IREFST_MASK
 260              	SetClock48MHz_Wait_MCG_S_IREFST_Clear:                      // do {
 261 0086 8279     	            LDRB    R2,[R0,#MCG_S_OFFSET]
 262 0088 1142     	            TST     R1,R2
 263 008a FCD1     	            BNE     SetClock48MHz_Wait_MCG_S_IREFST_Clear  // } while IREFST
 264              	// [1] omits this step
 265              	// Reference range:  31.25–39.0625 kHz
 266              	// FLL factor:  1280
 267              	// DCO range:  40–50 MHz
 268              	// Preserve FCTRIM and SCFTRIM
 269 008c C278     	            LDRB    R2,[R0,#MCG_C4_OFFSET]
 270 008e 6021     	            MOVS    R1,#MCG_C4_DRST_DRS_MASK
 271 0090 A023     	            MOVS    R3,#MCG_C4_DCO_25PMAX_MID
 272 0092 8A43     	            BICS    R2,R2,R1
 273 0094 1A43     	            ORRS    R2,R2,R3
 274 0096 C270     	            STRB    R2,[R0,#MCG_C4_OFFSET]
 275              	// Wait until output of FLL is selected [3]
 276 0098 0C21     	            MOVS    R1,#MCG_S_CLKST_MASK
 277              	SetClock48MHz_Wait_MCG_FLL_Selected:                      // do {
 278 009a 8279     	            LDRB    R2,[R0,#MCG_S_OFFSET]
 279 009c 1142     	            TST     R1,R2
 280 009e FCD1     	            BNE     SetClock48MHz_Wait_MCG_FLL_Selected  // } while CLKST
 281              	// Now have 48-MHz FLL clock,
 282              	// 48-MHz core clock, and 24-MHz bus clock
 283 00a0 0FBC     	            POP     {R0-R3}
 284 00a2 7047     	            BX      LR
 285              	                // SetClock48MHz
 286              	// ****************************************************************
 287              	.align
 288              	// Program template for CMPE-250 uses main as "Reset_Handler"
 289              	//            EXPORT  Reset_Handler
 290              	// ****************************************************************
 291              	// Goto main
 292              	// ****************************************************************
 293              	//            LDR     R0,=main
 294              	//            BX      R0
 295              	.global Dummy_Handler
 296              	.weak HardFault_Handler
 297              	.global HardFault_Handler
 298              	Dummy_Handler:  
 299              	HardFault_Handler:
 300              	// ****************************************************************
 301              	// Dummy exception handler (infinite loop)
 302              	// ****************************************************************
 303 00a4 FEE7     	            B       .
 304              	                // Dummy_Handler
 305              	// ---------------------------------------------------------------
 306 00a6 C046     	.balign 8
 307              	// ****************************************************************
 308              	.section prog_once
 309              	// Program once field:  0xC0-0xFF
 310 0000 00000000 	.skip 0x40
 310      00000000 
 310      00000000 
 310      00000000 
 310      00000000 
 311              	// ****************************************************************
 312              	.section keys, "ax"
 313 0000 FFFF     	.byte     FCF_BACKDOOR_KEY0,FCF_BACKDOOR_KEY1
 314 0002 FFFF     	.byte     FCF_BACKDOOR_KEY2,FCF_BACKDOOR_KEY3
 315 0004 FFFF     	.byte     FCF_BACKDOOR_KEY4,FCF_BACKDOOR_KEY5
 316 0006 FFFF     	.byte     FCF_BACKDOOR_KEY6,FCF_BACKDOOR_KEY7
 317 0008 FFFFFFFF 	.byte     FCF_FPROT0,FCF_FPROT1,FCF_FPROT2,FCF_FPROT3
 318 000c 7EFFFFFF 	.byte     FCF_FSEC,FCF_FOPT,0xFF,0xFF
 319              	// ****************************************************************
 320              	.section stack, "aw", %nobits
 321              	.align 3
 322              	// Allocate system stack beginning at lowest address of RAM
 323              	.set SSTACK_SIZE ,     0x00000100
 324              	Stack_Mem:
 325 0000 00000000 	.skip SSTACK_SIZE
 325      00000000 
 325      00000000 
 325      00000000 
 325      00000000 
 326              	.global __initial_sp
 327              	__initial_sp:
 328              	// ****************************************************************
 329              	.end
