 852              	// ****************************************************************
 853              	// Vector Table Mapped to Address 0 at Reset
 854              	// Linker requires __Vectors to be exported
 855              	.section RESET, "a"
 856              	            //  EXPORT  __Vectors
 857              	            //  EXPORT  __Vectors_End
 858              	            //  EXPORT  __Vectors_Size
 859              	            //  IMPORT  __initial_sp
 860              	            //  IMPORT  Dummy_Handler
 861              	            //  IMPORT  HardFault_Handler
 862              	.global __Vectors
 863              	.global __Vectors_End
 864              	.global __Vectors_Size
 865              	__Vectors:
 866              	                                        // ARM core vectors
 867 0000 00000000 	            .word    __initial_sp       // 00:end of stack
 868 0004 00000000 	            .word    Reset_Handler      // 01:reset vector
 869 0008 00000000 	            .word    Dummy_Handler      // 02:NMI
 870 000c 00000000 	            .word    HardFault_Handler  // 03:hard fault
 871 0010 00000000 	            .word    Dummy_Handler      // 04:(reserved)
 872 0014 00000000 	            .word    Dummy_Handler      // 05:(reserved)
 873 0018 00000000 	            .word    Dummy_Handler      // 06:(reserved)
 874 001c 00000000 	            .word    Dummy_Handler      // 07:(reserved)
 875 0020 00000000 	            .word    Dummy_Handler      // 08:(reserved)
 876 0024 00000000 	            .word    Dummy_Handler      // 09:(reserved)
 877 0028 00000000 	            .word    Dummy_Handler      // 10:(reserved)
 878 002c 00000000 	            .word    Dummy_Handler      // 11:SVCall (supervisor call)
 879 0030 00000000 	            .word    Dummy_Handler      // 12:(reserved)
 880 0034 00000000 	            .word    Dummy_Handler      // 13:(reserved)
 881 0038 00000000 	            .word    Dummy_Handler      // 14:PendSV (PendableSrvReq)
 882              	                                        //    pendable request 
 883              	                                        //    for system service)
 884 003c 00000000 	            .word    Dummy_Handler      // 15:SysTick (system tick timer)
 885 0040 00000000 	            .word    Dummy_Handler      // 16:DMA channel 0 transfer 
 886              	                                        //    complete/error
 887 0044 00000000 	            .word    Dummy_Handler      // 17:DMA channel 1 transfer
 888              	                                        //    complete/error
 889 0048 00000000 	            .word    Dummy_Handler      // 18:DMA channel 2 transfer
 890              	                                        //    complete/error
 891 004c 00000000 	            .word    Dummy_Handler      // 19:DMA channel 3 transfer
 892              	                                        //    complete/error
 893 0050 00000000 	            .word    Dummy_Handler      // 20:(reserved)
 894 0054 00000000 	            .word    Dummy_Handler      // 21:FTFA command complete/
 895              	                                        //    read collision
 896 0058 00000000 	            .word    Dummy_Handler      // 22:low-voltage detect;
 897              	                                        //    low-voltage warning
 898 005c 00000000 	            .word    Dummy_Handler      // 23:low leakage wakeup
 899 0060 00000000 	            .word    Dummy_Handler      // 24:I2C0
 900 0064 00000000 	            .word    Dummy_Handler      // 25:(reserved)
 901 0068 00000000 	            .word    Dummy_Handler      // 26:SPI0
 902 006c 00000000 	            .word    Dummy_Handler      // 27:(reserved)
 903 0070 44010000 	            .word    UART0_ISR          // 28:UART0 (status; error)
 904 0074 00000000 	            .word    Dummy_Handler      // 29:(reserved)
 905 0078 00000000 	            .word    Dummy_Handler      // 30:(reserved)
 906 007c 00000000 	            .word    Dummy_Handler      // 31:ADC0
 907 0080 00000000 	            .word    Dummy_Handler      // 32:CMP0
 908 0084 00000000 	            .word    Dummy_Handler      // 33:TPM0
 909 0088 00000000 	            .word    Dummy_Handler      // 34:TPM1
 910 008c 00000000 	            .word    Dummy_Handler      // 35:(reserved)
 911 0090 00000000 	            .word    Dummy_Handler      // 36:RTC (alarm)
 912 0094 00000000 	            .word    Dummy_Handler      // 37:RTC (seconds)
 913 0098 00000000 	            .word    Dummy_Handler      // 38:PIT
 914 009c 00000000 	            .word    Dummy_Handler      // 39:(reserved)
 915 00a0 00000000 	            .word    Dummy_Handler      // 40:(reserved)
 916 00a4 00000000 	            .word    Dummy_Handler      // 41:DAC0
 917 00a8 00000000 	            .word    Dummy_Handler      // 42:TSI0
 918 00ac 00000000 	            .word    Dummy_Handler      // 43:MCG
 919 00b0 00000000 	            .word    Dummy_Handler      // 44:LPTMR0
 920 00b4 00000000 	            .word    Dummy_Handler      // 45:(reserved)
 921 00b8 00000000 	            .word    Dummy_Handler      // 46:PORTA
 922 00bc 00000000 	            .word    Dummy_Handler      // 47:PORTB
 923              	__Vectors_End:
 924              	.set __Vectors_Size, __Vectors_End - __Vectors
 925              	.balign 4
