 850              	// Vector Table Mapped to Address 0 at Reset
 851              	// Linker requires __Vectors to be exported
 852 0362 0000     	.section RESET, "a"
 853              	            //  EXPORT  __Vectors
 854              	            //  EXPORT  __Vectors_End
 855              	            //  EXPORT  __Vectors_Size
 856              	            //  IMPORT  __initial_sp
 857              	            //  IMPORT  Dummy_Handler
 858              	            //  IMPORT  HardFault_Handler
 859              	.global __Vectors
 860              	.global __Vectors_End
 861              	.global __Vectors_Size
 862              	__Vectors:
 863              	                                        // ARM core vectors
 864 0000 00000000 	            .word    __initial_sp       // 00:end of stack
 865 0004 00000000 	            .word    Reset_Handler      // 01:reset vector
 866 0008 00000000 	            .word    Dummy_Handler      // 02:NMI
 867 000c 00000000 	            .word    HardFault_Handler  // 03:hard fault
 868 0010 00000000 	            .word    Dummy_Handler      // 04:(reserved)
 869 0014 00000000 	            .word    Dummy_Handler      // 05:(reserved)
 870 0018 00000000 	            .word    Dummy_Handler      // 06:(reserved)
 871 001c 00000000 	            .word    Dummy_Handler      // 07:(reserved)
 872 0020 00000000 	            .word    Dummy_Handler      // 08:(reserved)
 873 0024 00000000 	            .word    Dummy_Handler      // 09:(reserved)
 874 0028 00000000 	            .word    Dummy_Handler      // 10:(reserved)
 875 002c 00000000 	            .word    Dummy_Handler      // 11:SVCall (supervisor call)
 876 0030 00000000 	            .word    Dummy_Handler      // 12:(reserved)
 877 0034 00000000 	            .word    Dummy_Handler      // 13:(reserved)
 878 0038 00000000 	            .word    Dummy_Handler      // 14:PendSV (PendableSrvReq)
 879              	                                        //    pendable request 
 880              	                                        //    for system service)
 881 003c 00000000 	            .word    Dummy_Handler      // 15:SysTick (system tick timer)
 882 0040 00000000 	            .word    Dummy_Handler      // 16:DMA channel 0 transfer 
 883              	                                        //    complete/error
 884 0044 00000000 	            .word    Dummy_Handler      // 17:DMA channel 1 transfer
 885              	                                        //    complete/error
 886 0048 00000000 	            .word    Dummy_Handler      // 18:DMA channel 2 transfer
 887              	                                        //    complete/error
 888 004c 00000000 	            .word    Dummy_Handler      // 19:DMA channel 3 transfer
 889              	                                        //    complete/error
 890 0050 00000000 	            .word    Dummy_Handler      // 20:(reserved)
 891 0054 00000000 	            .word    Dummy_Handler      // 21:FTFA command complete/
 892              	                                        //    read collision
 893 0058 00000000 	            .word    Dummy_Handler      // 22:low-voltage detect;
 894              	                                        //    low-voltage warning
 895 005c 00000000 	            .word    Dummy_Handler      // 23:low leakage wakeup
 896 0060 00000000 	            .word    Dummy_Handler      // 24:I2C0
 897 0064 00000000 	            .word    Dummy_Handler      // 25:(reserved)
 898 0068 00000000 	            .word    Dummy_Handler      // 26:SPI0
 899 006c 00000000 	            .word    Dummy_Handler      // 27:(reserved)
 900 0070 44010000 	            .word    UART0_ISR          // 28:UART0 (status; error)
 901 0074 00000000 	            .word    Dummy_Handler      // 29:(reserved)
 902 0078 00000000 	            .word    Dummy_Handler      // 30:(reserved)
 903 007c 00000000 	            .word    Dummy_Handler      // 31:ADC0
 904 0080 00000000 	            .word    Dummy_Handler      // 32:CMP0
 905 0084 00000000 	            .word    Dummy_Handler      // 33:TPM0
 906 0088 00000000 	            .word    Dummy_Handler      // 34:TPM1
 907 008c 00000000 	            .word    Dummy_Handler      // 35:(reserved)
 908 0090 00000000 	            .word    Dummy_Handler      // 36:RTC (alarm)
 909 0094 00000000 	            .word    Dummy_Handler      // 37:RTC (seconds)
 910 0098 00000000 	            .word    Dummy_Handler      // 38:PIT
 911 009c 00000000 	            .word    Dummy_Handler      // 39:(reserved)
 912 00a0 00000000 	            .word    Dummy_Handler      // 40:(reserved)
 913 00a4 00000000 	            .word    Dummy_Handler      // 41:DAC0
 914 00a8 00000000 	            .word    Dummy_Handler      // 42:TSI0
 915 00ac 00000000 	            .word    Dummy_Handler      // 43:MCG
 916 00b0 00000000 	            .word    Dummy_Handler      // 44:LPTMR0
 917 00b4 00000000 	            .word    Dummy_Handler      // 45:(reserved)
 918 00b8 00000000 	            .word    Dummy_Handler      // 46:PORTA
 919 00bc 00000000 	            .word    Dummy_Handler      // 47:PORTB
