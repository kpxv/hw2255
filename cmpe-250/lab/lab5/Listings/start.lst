  176 0000004A         SetClock48MHz
                               PROC             {R0-R14}
  177 0000004A         ;*******************************************************
                       *********
  178 0000004A         ;Multipurpose clock generator (MCG) in FLL engaged exter
                       nal (FEE) mode
  179 0000004A         ;Establishes 48-MHz FLL clock from 32.678-kHz external c
                       rystal
  180 0000004A         ;Core clock = 47.97MHz
  181 0000004A         ;BusClock = 23.98MHz
  182 0000004A         ;Corresponds to CLOCK_SETUP = 1 in system_MKL05Z4.c
  183 0000004A         ;Follows [3], [2].24.5.1 MCG module initialization seque
                       nce,
  184 0000004A         ;  and [1].4.1 Clocking 3: Configuration examples,
  185 0000004A         ;[1] Freescale Semiconductor, <B>Kinetis L Peripheral Mo
                       dule Quick
  186 0000004A         ;    Reference</B>, KLQRUG, Rev. 0, 9/2012.
  187 0000004A         ;[2] Freescale Semiconductor, <B>KL05 Sub-Family Referen
                       ce Manual</B>,
  188 0000004A         ;    KL05P48M48SF1RM, Rev. 3.1, 11/2012.
  189 0000004A         ;[3] Freescale startup_MKL05Z4.s and system_MKL05Z4.c
  190 0000004A         ;    rev. 1.6, 4/11/2013
  191 0000004A         ;Input:  None
  192 0000004A         ;Output:  None
  193 0000004A         ;Modifies:  APSR
  194 0000004A         ;*******************************************************
                       *********
  195 0000004A B40F            PUSH             {R0-R3}
  196 0000004C         ;Configure for external clock from external 32-kHz oscil
                       lator
  197 0000004C         ;  EXTAL0 on PTA3
  198 0000004C         ;  XTAL0 on PTA4
  199 0000004C         ;Enable PORT A
  200 0000004C 4817            LDR              R0,=SIM_SCGC5
  201 0000004E 4918            LDR              R1,=SIM_SCGC5_PORTA_MASK
  202 00000050 6802            LDR              R2,[R0,#0]
  203 00000052 430A            ORRS             R2,R2,R1
  204 00000054 6002            STR              R2,[R0,#0]
  205 00000056         ;Set PORT A Pin 3 for EXTAL0
  206 00000056 4817            LDR              R0,=PORTA_BASE
  207 00000058 4917            LDR              R1,=PORT_PCR_SET_PTA3_EXTAL
  208 0000005A 60C1            STR              R1,[R0,#PORTA_PCR3_OFFSET]
  209 0000005C         ;Set PORT A Pin 4 for XTAL0
  210 0000005C         ;PORT_PCR_SET same as PTA3 already in R1
  211 0000005C         ;LDR     R1,=PORT_PCR_SET_PTA4_EXTAL
  212 0000005C 6101            STR              R1,[R0,#PORTA_PCR4_OFFSET]
  213 0000005E         ;Update clock dividers:  system/core = 1; bus/flash = 2
  214 0000005E         ;[1] defers this step until first part of switching to F
                       EE mode
  215 0000005E 4817            LDR              R0,=SIM_CLKDIV1
  216 00000060 4917            LDR              R1,=SIM_CLKDIV1_COREDIV1_BUSDIV
2
  217 00000062 6001            STR              R1,[R0,#0]
  218 00000064         ;------------------------------------------
  219 00000064         ;Establish FLL engaged external mode (FEE)
  220 00000064         ;------------------------------------------
  221 00000064         ;First configure oscillator settings in MCG_C2
  222 00000064         ;  RANGE is determined from external frequency



ARM Macro Assembler    Page 6 KL05 Bare Metal Assembly Startup


  223 00000064         ;  Since RANGE affects FRDIV, it must be set
  224 00000064         ;  correctly even with an external clock
  225 00000064         ;  * Low frequency range
  226 00000064         ;  * External reference oscillator
  227 00000064 4817            LDR              R0,=MCG_BASE
  228 00000066 2104            MOVS             R1,#MCG_C2_LF_EREFOSC
  229 00000068 7041            STRB             R1,[R0,#MCG_C2_OFFSET]
  230 0000006A         ;Enable external reference clock OSCERCLK,
  231 0000006A         ;without additional oscillator load
  232 0000006A 4A17            LDR              R2,=OSC0_CR
  233 0000006C 2180            MOVS             R1,#OSC0_CR_ERCLK_STOP_NOLOAD
  234 0000006E 7011            STRB             R1,[R2,#0]
  235 00000070         ;FRDIV set to keep FLL ref clock within
  236 00000070         ;correct range, determined by ref clock.
  237 00000070         ;  For 1-KHz ref, need divide by 1 (FRDIV = 0)
  238 00000070         ;  CLKS must be set to 2_00 to select FLL
  239 00000070         ;  Clearing IREFS selects and enables
  240 00000070         ;    external oscillator
  241 00000070         ;  [3] sets IRCLKEN for internal reference clock as MCGI
                       RCLK
  242 00000070         ;  [2] states this is optional:  convenient to allow
  243 00000070         ;      switching between internal and external but
  244 00000070         ;      consumes more power
  245 00000070 2102            MOVS             R1,#MCG_C1_FLL_DIV1_IRCLKEXTSTO
P
  246 00000072 7001            STRB             R1,[R0,#MCG_C1_OFFSET]
  247 00000074         ;Wait for oscillator initialization cycles
  248 00000074         ;to complete and become stable
  249 00000074         ;[2] suggests doing this step here
  250 00000074         ;[3] omits this step
  251 00000074 2102            MOVS             R1,#MCG_S_OSCINIT0_MASK
  252 00000076         SetClock48MHz_Wait_MCG_S_OSCINIT0    ;repeat {
  253 00000076 7982            LDRB             R2,[R0,#MCG_S_OFFSET]
  254 00000078 4211            TST              R1,R2
  255 0000007A D0FC            BEQ              SetClock48MHz_Wait_MCG_S_OSCINI
T0 
                                                            ;} until OSCINIT0
  256 0000007C         ;Wait for source of the FLL reference clock 
  257 0000007C         ;to be the external reference clock.
  258 0000007C         ;[2] suggests doing this step here
  259 0000007C         ;[3] defers until after MCG_C4 initialization
  260 0000007C         ;(MCG_S:  IREFST becomes 0)
  261 0000007C 2110            MOVS             R1,#MCG_S_IREFST_MASK
  262 0000007E         SetClock48MHz_Wait_MCG_S_IREFST_Clear ;do {
  263 0000007E 7982            LDRB             R2,[R0,#MCG_S_OFFSET]
  264 00000080 4211            TST              R1,R2
  265 00000082 D1FC            BNE              SetClock48MHz_Wait_MCG_S_IREFST
_Clear 
                                                            ;} while IREFST
  266 00000084         ;[1] omits this step
  267 00000084         ;Reference range:  31.25–39.0625 kHz
  268 00000084         ;FLL factor:  1280
  269 00000084         ;DCO range:  40–50 MHz
  270 00000084         ;Preserve FCTRIM and SCFTRIM
  271 00000084 78C2            LDRB             R2,[R0,#MCG_C4_OFFSET]
  272 00000086 2160            MOVS             R1,#MCG_C4_DRST_DRS_MASK
  273 00000088 23A0            MOVS             R3,#MCG_C4_DCO_25PMAX_MID
  274 0000008A 438A            BICS             R2,R2,R1
  275 0000008C 431A            ORRS             R2,R2,R3



ARM Macro Assembler    Page 7 KL05 Bare Metal Assembly Startup


  276 0000008E 70C2            STRB             R2,[R0,#MCG_C4_OFFSET]
  277 00000090         ;Wait until output of FLL is selected [3]
  278 00000090 210C            MOVS             R1,#MCG_S_CLKST_MASK
  279 00000092         SetClock48MHz_Wait_MCG_FLL_Selected  ;do {
  280 00000092 7982            LDRB             R2,[R0,#MCG_S_OFFSET]
  281 00000094 4211            TST              R1,R2
  282 00000096 D1FC            BNE              SetClock48MHz_Wait_MCG_FLL_Sele
cted 
                                                            ;} while CLKST
  283 00000098         ;Now have 48-MHz FLL clock,
  284 00000098         ;48-MHz core clock, and 24-MHz bus clock
  285 00000098 BC0F            POP              {R0-R3}
  286 0000009A 4770            BX               LR
  287 0000009C                 ENDP                         ;SetClock48MHz
