                               PROC             {}
  129 0000000E         ;*******************************************************
                       *********
  130 0000000E         ;Performs the following system initialization tasks.
  131 0000000E         ;* Mask interrupts
  132 0000000E         ;* Disable watchdog timer (+)
  133 0000000E         ;* Initialize registers to known state for debugger
  134 0000000E         ;+:Following [1].1.1.4.2 Startup routines: 1 Disable wat
                       chdog
  135 0000000E         ;[1] Freescale Semiconductor, <B>Kinetis L Peripheral Mo
                       dule Quick
  136 0000000E         ;    Reference</B>, KLQRUG, Rev. 0, 9/2012.
  137 0000000E         ;Input:  None
  138 0000000E         ;Output:  None
  139 0000000E         ;Modifies:  R0-R15;APSR
  140 0000000E         ;*******************************************************
                       *********
  141 0000000E         ;Mask interrupts
  142 0000000E B672            CPSID            I
  143 00000010         ;Disable COP watchdog timer
  144 00000010 4823            LDR              R0,=SIM_COPC
  145 00000012 2100            MOVS             R1,#SIM_COPC_COP_DISABLED
  146 00000014 6001            STR              R1,[R0,#0]
  147 00000016         ;Put return address on stack
  148 00000016 B500            PUSH             {LR}
  149 00000018         ;Initialize registers
  150 00000018 4922            LDR              R1,=0x11111111
  151 0000001A 184A            ADDS             R2,R1,R1
  152 0000001C 1853            ADDS             R3,R2,R1
  153 0000001E 185C            ADDS             R4,R3,R1
  154 00000020 1865            ADDS             R5,R4,R1
  155 00000022 186E            ADDS             R6,R5,R1
  156 00000024 1877            ADDS             R7,R6,R1
  157 00000026 4688            MOV              R8,R1
  158 00000028 44B8            ADD              R8,R8,R7
  159 0000002A 4689            MOV              R9,R1
  160 0000002C 44C1            ADD              R9,R9,R8
  161 0000002E 468A            MOV              R10,R1
  162 00000030 44CA            ADD              R10,R10,R9
  163 00000032 468B            MOV              R11,R1
  164 00000034 44D3            ADD              R11,R11,R10
  165 00000036 468C            MOV              R12,R1
  166 00000038 44DC            ADD              R12,R12,R11
  167 0000003A 4696            MOV              R14,R2
  168 0000003C 44E6            ADD              R14,R14,R12
  169 0000003E 4608            MOV              R0,R1
  170 00000040 4470            ADD              R0,R0,R14
  171 00000042 F380 8800       MSR              APSR,R0
  172 00000046 4818            LDR              R0,=0x05250113
  173 00000048 BD00            POP              {PC}
