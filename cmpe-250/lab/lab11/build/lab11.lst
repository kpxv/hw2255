 259              	// Vector Table Mapped to Address 0 at Reset
 260              	// Linker requires __Vectors to be exported
 261              	.section RESET, "a"
 262              	            //  EXPORT  __Vectors
 263              	            //  EXPORT  __Vectors_End
 264              	            //  EXPORT  __Vectors_Size
 265              	            //  IMPORT  __initial_sp
 266              	            //  IMPORT  Dummy_Handler
 267              	            //  IMPORT  HardFault_Handler
 268              	.global __Vectors
 269              	.global __Vectors_End
 270              	.global __Vectors_Size
 271              	__Vectors:
 272              	                                        // ARM core vectors
 273 0000 00000000 	            .word    __initial_sp       // 00:end of stack
 274 0004 00000000 	            .word    Reset_Handler      // 01:reset vector
 275 0008 00000000 	            .word    Dummy_Handler      // 02:NMI
 276 000c 00000000 	            .word    HardFault_Handler  // 03:hard fault
 277 0010 00000000 	            .word    Dummy_Handler      // 04:(reserved)
 278 0014 00000000 	            .word    Dummy_Handler      // 05:(reserved)
 279 0018 00000000 	            .word    Dummy_Handler      // 06:(reserved)
 280 001c 00000000 	            .word    Dummy_Handler      // 07:(reserved)
 281 0020 00000000 	            .word    Dummy_Handler      // 08:(reserved)
 282 0024 00000000 	            .word    Dummy_Handler      // 09:(reserved)
 283 0028 00000000 	            .word    Dummy_Handler      // 10:(reserved)
 284 002c 00000000 	            .word    Dummy_Handler      // 11:SVCall (supervisor call)
 285 0030 00000000 	            .word    Dummy_Handler      // 12:(reserved)
 286 0034 00000000 	            .word    Dummy_Handler      // 13:(reserved)
 287 0038 00000000 	            .word    Dummy_Handler      // 14:PendSV (PendableSrvReq)
 288              	                                        //    pendable request 
 289              	                                        //    for system service)
 290 003c 00000000 	            .word    Dummy_Handler      // 15:SysTick (system tick timer)
 291 0040 00000000 	            .word    Dummy_Handler      // 16:DMA channel 0 transfer 
 292              	                                        //    complete/error
 293 0044 00000000 	            .word    Dummy_Handler      // 17:DMA channel 1 transfer
 294              	                                        //    complete/error
 295 0048 00000000 	            .word    Dummy_Handler      // 18:DMA channel 2 transfer
 296              	                                        //    complete/error
 297 004c 00000000 	            .word    Dummy_Handler      // 19:DMA channel 3 transfer
 298              	                                        //    complete/error
 299 0050 00000000 	            .word    Dummy_Handler      // 20:(reserved)
 300 0054 00000000 	            .word    Dummy_Handler      // 21:FTFA command complete/
 301              	                                        //    read collision
 302 0058 00000000 	            .word    Dummy_Handler      // 22:low-voltage detect;
 303              	                                        //    low-voltage warning
 304 005c 00000000 	            .word    Dummy_Handler      // 23:low leakage wakeup
 305 0060 00000000 	            .word    Dummy_Handler      // 24:I2C0
 306 0064 00000000 	            .word    Dummy_Handler      // 25:(reserved)
 307 0068 00000000 	            .word    Dummy_Handler      // 26:SPI0
 308 006c 00000000 	            .word    Dummy_Handler      // 27:(reserved)
 309 0070 00000000 	            .word    UART0_ISR          // 28:UART0 (status; error)
 310 0074 00000000 	            .word    Dummy_Handler      // 29:(reserved)
 311 0078 00000000 	            .word    Dummy_Handler      // 30:(reserved)
 312 007c 00000000 	            .word    Dummy_Handler      // 31:ADC0
 313 0080 00000000 	            .word    Dummy_Handler      // 32:CMP0
 314 0084 00000000 	            .word    Dummy_Handler      // 33:TPM0
 315 0088 00000000 	            .word    Dummy_Handler      // 34:TPM1
 316 008c 00000000 	            .word    Dummy_Handler      // 35:(reserved)
 317 0090 00000000 	            .word    Dummy_Handler      // 36:RTC (alarm)
 318 0094 00000000 	            .word    Dummy_Handler      // 37:RTC (seconds)
 319 0098 00000000 	            .word    PIT_ISR            // 38:PIT
 320 009c 00000000 	            .word    Dummy_Handler      // 39:(reserved)
 321 00a0 00000000 	            .word    Dummy_Handler      // 40:(reserved)
 322 00a4 00000000 	            .word    Dummy_Handler      // 41:DAC0
 323 00a8 00000000 	            .word    Dummy_Handler      // 42:TSI0
 324 00ac 00000000 	            .word    Dummy_Handler      // 43:MCG
 325 00b0 00000000 	            .word    Dummy_Handler      // 44:LPTMR0
 326 00b4 00000000 	            .word    Dummy_Handler      // 45:(reserved)
 327 00b8 00000000 	            .word    Dummy_Handler      // 46:PORTA
 328 00bc 00000000 	            .word    Dummy_Handler      // 47:PORTB
 329              	__Vectors_End:
 330              	.set __Vectors_Size, __Vectors_End - __Vectors
 331              	.balign 4
