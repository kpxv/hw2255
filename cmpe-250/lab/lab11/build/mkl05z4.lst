 2293              	// ---------------------------------------------------------------
 2294              	// TPMx_CnSC:  Channel n Status and Control
 2295              	// 31-8:(reserved):read-only:0
 2296              	//    7:CHF=channel flag (0)
 2297              	//          set on channel event
 2298              	//          write 1 to clear
 2299              	//    6:CHIE=channel interrupt enable (0)
 2300              	//    5:MSB=channel mode select B (0) (see selection table below)
 2301              	//    4:MSA=channel mode select A (0) (see selection table below)
 2302              	//    3:ELSB=edge or level select B (0) (see selection table below)
 2303              	//    2:ELSA=edge or level select A (0) (see selection table below)
 2304              	//    1:(reserved):read-only:0
 2305              	//    0:DMA=DMA enable (0)
 2306              	// Mode, Edge, and Level Selection
 2307              	// MSB:MSA | ELSB:ELSA | Mode           | Configuration
 2308              	//   0 0   |    0 0    | (none)         | channel disabled
 2309              	//   0 1   |    0 0    | SW compare     | pin not used
 2310              	//   1 X   |    0 0    | SW compare     | pin not used
 2311              	//   0 0   |    0 1    | input capture  | rising edge
 2312              	//   0 0   |    1 0    | input capture  | falling edge
 2313              	//   0 0   |    1 1    | input capture  | either edge
 2314              	//   0 1   |    0 1    | output compare | toggle on match
 2315              	//   0 1   |    1 0    | output compare | clear on match
 2316              	//   0 1   |    1 1    | output compare | set on match
 2317              	//   1 0   |    X 1    | PWM            | low pulse
 2318              	//   1 0   |    1 0    | PWM            | high pulse
 2319              	//   1 1   |    X 1    | output compare | pulse high on match
 2320              	//   1 1   |    1 0    | output compare | pulse low on match
 2321              	.set TPM_CnSC_CHF_MASK    ,  0x80
 2322              	.set TPM_CnSC_CHF_SHIFT   ,  7
