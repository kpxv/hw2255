 1313              	.set NV_BACKKEY4         ,  (NV_BASE + NV_BACKKEY4_OFFSET)
 1314              	.set NV_FPROT3           ,  (NV_BASE + NV_FPROT3_OFFSET)
 1315              	.set NV_FPROT2           ,  (NV_BASE + NV_FPROT2_OFFSET)
 1316              	.set NV_FPROT1           ,  (NV_BASE + NV_FPROT1_OFFSET)
 1317              	.set NV_FPROT0           ,  (NV_BASE + NV_FPROT0_OFFSET)
 1318              	.set NV_FSEC             ,  (NV_BASE + NV_FSEC_OFFSET)
 1319              	.set NV_FOPT             ,  (NV_BASE + NV_FOPT_OFFSET)
 1320              	// ---------------------------------------------------------------
 1321              	// NV FCF Backdoor Comparison Key 3
 1322              	.set NV_BACKKEY3_KEY_MASK   ,  0xFF
 1323              	.set NV_BACKKEY3_KEY_SHIFT  ,  0
 1324              	// ---------------------------------------------------------------
 1325              	// NV FCF Backdoor Comparison Key 2
 1326              	.set NV_BACKKEY2_KEY_MASK   ,  0xFF
 1327              	.set NV_BACKKEY2_KEY_SHIFT  ,  0
 1328              	// ---------------------------------------------------------------
 1329              	// NV FCF Backdoor Comparison Key 1
 1330              	.set NV_BACKKEY1_KEY_MASK   ,  0xFF
 1331              	.set NV_BACKKEY1_KEY_SHIFT  ,  0
 1332              	// ---------------------------------------------------------------
 1333              	// NV FCF Backdoor Comparison Key 0
 1334              	.set NV_BACKKEY0_KEY_MASK   ,  0xFF
 1335              	.set NV_BACKKEY0_KEY_SHIFT  ,  0
 1336              	// ---------------------------------------------------------------
 1337              	// NV FCF Backdoor Comparison Key 7
 1338              	.set NV_BACKKEY7_KEY_MASK   ,  0xFF
 1339              	.set NV_BACKKEY7_KEY_SHIFT  ,  0
 1340              	// ---------------------------------------------------------------
 1341              	// NV FCF Backdoor Comparison Key 6
 1342              	.set NV_BACKKEY6_KEY_MASK   ,  0xFF
 1343              	.set NV_BACKKEY6_KEY_SHIFT  ,  0
 1344              	// ---------------------------------------------------------------
 1345              	// NV FCF Backdoor Comparison Key 5
 1346              	.set NV_BACKKEY5_KEY_MASK   ,  0xFF
 1347              	.set NV_BACKKEY5_KEY_SHIFT  ,  0
 1348              	// ---------------------------------------------------------------
 1349              	// NV FCF Backdoor Comparison Key 4
 1350              	.set NV_BACKKEY4_KEY_MASK   ,  0xFF
 1351              	.set NV_BACKKEY4_KEY_SHIFT  ,  0
 1352              	// ---------------------------------------------------------------
 1353              	// NV FCF Flash Program Protection Byte 3
 1354              	.set NV_FPROT3_PROT_MASK   ,  0xFF
 1355              	.set NV_FPROT3_PROT_SHIFT  ,  0
 1356              	// ---------------------------------------------------------------
 1357              	// NV FCF Flash Program Protection Byte 2
 1358              	.set NV_FPROT2_PROT_MASK   ,  0xFF
 1359              	.set NV_FPROT2_PROT_SHIFT  ,  0
 1360              	// ---------------------------------------------------------------
 1361              	// NV FCF Flash Program Protection Byte 1
 1362              	.set NV_FPROT1_PROT_MASK   ,  0xFF
 1363              	.set NV_FPROT1_PROT_SHIFT  ,  0
 1364              	// ---------------------------------------------------------------
 1365              	// NV FCF Flash Program Protection Byte 0
