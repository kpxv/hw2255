 2198              	//    17:UART1ODE=UART1 open drain enable
 2199              	//    16:UART0ODE=UART0 open drain enable
 2200              	// 15-07:Reserved; read-only; always 0
 2201              	//    06:UART1TXSRC=UART1 receive data select
