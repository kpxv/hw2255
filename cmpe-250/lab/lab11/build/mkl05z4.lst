 2207              	//                 :10=UART1_TX pin modulated with TPM2 channel 0 output
 2208              	//                 :11=(reserved)
 2209              	//    03:Reserved; read-only; always 0
 2210              	//    02:UART0RXSRC=UART0 receive data select
 2211              	//                 :0=UART0_RX pin
 2212              	//                 :1=CMP0 output
 2213              	// 01-00:UART0TXSRC=UART0 transmit data select source
 2214              	//                 :00=UART0_TX pin
 2215              	//                 :01=UART0_TX pin modulated with TPM1 channel 0 output
 2216              	//                 :10=UART0_TX pin modulated with TPM2 channel 0 output
 2217              	//                 :11=(reserved)
 2218              	.set SIM_SOPT5_UART0ODE_MASK     ,  0x00010000
 2219              	.set SIM_SOPT5_UART0ODE_SHIFT    ,  16
