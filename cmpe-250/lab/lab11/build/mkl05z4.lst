 1991              	.set SIM_SOPT7_OFFSET     ,  0x1018
 1992              	.set SIM_SDID_OFFSET      ,  0x1024
 1993              	.set SIM_SCGC4_OFFSET     ,  0x1034
 1994              	.set SIM_SCGC5_OFFSET     ,  0x1038
 1995              	.set SIM_SCGC6_OFFSET     ,  0x103C
 1996              	.set SIM_SCGC7_OFFSET     ,  0x1040
 1997              	.set SIM_CLKDIV1_OFFSET   ,  0x1044
 1998              	.set SIM_FCFG1_OFFSET     ,  0x104C
 1999              	.set SIM_FCFG2_OFFSET     ,  0x1050
 2000              	.set SIM_UIDMH_OFFSET     ,  0x1058
 2001              	.set SIM_UIDML_OFFSET     ,  0x105C
