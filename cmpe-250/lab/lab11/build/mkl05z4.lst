 1630              	.set PIT_TCTRL1_OFFSET   ,  0x118
 1631              	.set PIT_TFLG1_OFFSET    ,  0x11C
 1632              	.set PIT_MCR      ,  (PIT_BASE + PIT_MCR_OFFSET)
 1633              	.set PIT_LTMR64H  ,  (PIT_BASE + PIT_LTMR64H_OFFSET)
 1634              	.set PIT_LTMR64L  ,  (PIT_BASE + PIT_LTMR64L_OFFSET)
 1635              	.set PIT_LDVAL0   ,  (PIT_BASE + PIT_LDVAL0_OFFSET)
 1636              	.set PIT_CVAL0    ,  (PIT_BASE + PIT_CVAL0_OFFSET)
 1637              	.set PIT_TCTRL0   ,  (PIT_BASE + PIT_TCTRL0_OFFSET)
 1638              	.set PIT_TFLG0    ,  (PIT_BASE + PIT_TFLG0_OFFSET)
 1639              	.set PIT_LDVAL1   ,  (PIT_BASE + PIT_LDVAL1_OFFSET)
 1640              	.set PIT_CVAL1    ,  (PIT_BASE + PIT_CVAL1_OFFSET)
 1641              	.set PIT_TCTRL1   ,  (PIT_BASE + PIT_TCTRL1_OFFSET)
 1642              	.set PIT_TFLG1    ,  (PIT_BASE + PIT_TFLG1_OFFSET)
 1643              	// ---------------------------------------------------------------
 1644              	// PIT_CVALn:  current timer value register (channel n)
 1645              	// 31-0:TVL=current timer value
 1646              	// ---------------------------------------------------------------
 1647              	// PIT_LDVALn:  timer load value register (channel n)
 1648              	// 31-0:TSV=timer start value
 1649              	//          PIT chan. n counts down from this value to 0,
 1650              	//          then sets TIF and loads LDVALn
 1651              	// ---------------------------------------------------------------
 1652              	// PIT_LTMR64H:  PIT upper lifetime timer register
 1653              	// for applications chaining timer 0 and timer 1 for 64-bit timer
 1654              	// 31-0:LTH=life timer value (high word)
 1655              	//          value of timer 1 (CVAL1); read before PIT_LTMR64L
 1656              	// ---------------------------------------------------------------
 1657              	// PIT_LTMR64L:  PIT lower lifetime timer register
 1658              	// for applications chaining timer 0 and timer 1 for 64-bit timer
 1659              	// 31-0:LTL=life timer value (low word)
 1660              	//          value of timer 0 (CVAL0); read after PIT_LTMR64H
 1661              	// ---------------------------------------------------------------
 1662              	// PIT_MCR:  PIT module control register
 1663              	// 31-3:(reserved):read-only:0
 1664              	//    2:(reserved)
 1665              	//    1:MDIS=module disable (PIT section)
 1666              	//           RTI timer not affected by this field
 1667              	//           must be enabled before any other setup
 1668              	//    0:FRZ=freeze:  continue'/stop timers in debug mode
 1669              	.set PIT_MCR_MDIS_MASK   ,  0x00000002
 1670              	.set PIT_MCR_MDIS_SHIFT  ,  1
 1671              	.set PIT_MCR_FRZ_MASK    ,  0x00000001
 1672              	.set PIT_MCR_FRZ_SHIFT   ,  0
 1673              	// ---------------------------------------------------------------
 1674              	// PIT_TCTRLn:  timer control register (channel n)
 1675              	// 31-3:(reserved):read-only:0
 1676              	//    2:CHN=chain mode (enable)
 1677              	//           in chain mode, channel n-1 must expire before
 1678              	//                          channel n counts
 1679              	//           timer 0 cannot be changed
 1680              	//    1:TIE=timer interrupt enable (on TIF)
 1681              	//    0:TEN=timer enable
 1682              	.set PIT_TCTRL_CHN_MASK   ,  0x00000004
 1683              	.set PIT_TCTRL_CHN_SHIFT  ,  2
 1684              	.set PIT_TCTRL_TIE_MASK   ,  0x00000002
 1685              	.set PIT_TCTRL_TIE_SHIFT  ,  1
 1686              	.set PIT_TCTRL_TEN_MASK   ,  0x00000001
 1687              	.set PIT_TCTRL_TEN_SHIFT  ,  0
 1688              	// ---------------------------------------------------------------
 1689              	// PIT_TFLGn:  timer flag register (channel n)
 1690              	// 31-1:(reserved):read-only:0
 1691              	//    0:TIF=timer interrupt flag
 1692              	//          write 1 to clear
 1693              	.set PIT_TFLG_TIF_MASK   ,  0x00000001
 1694              	.set PIT_TFLG_TIF_SHIFT  ,  0
