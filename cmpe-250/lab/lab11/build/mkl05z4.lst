   1              	// **********************************************************************
   2              	// Freescale MKL05Z32xxx4 device values and configuration code
   3              	// * CPU Architecture values
   4              	// * CPU Registers
   5              	// * Various core, system, and peripheral modules and interfaces
   6              	// [1] Freescale Semiconductor, <B>Kinetis L Peripheral Module Quick
   7              	//     Reference</B>, KLQRUG, Rev. 0, 9/2012.
   8              	// [2] Freescale Semiconductor, <B>KL05 Sub-Family Reference Manual</B>,
   9              	//     KL05P48M48SF1RM, Rev. 3.1, 11/2012.
  10              	// [3] Freescale Semiconductor, MKL05Z4.h, rev. 1.6, 4/11/2013
  11              	// [4] Arm, core_cm0plus.h, v5.0.9, 8/21/2019
  12              	// [5] RIT CMPE-250 MKL46Z4.s, rev. 1/5/2018
  13              	// [6] Freescale startup_MKL05Z4.s
  14              	//     CMSIS Cortex-M0plus Core Device Startup File for the MKL05Z4
  15              	//     v1.6, 4/11/
  16              	//     FTFA_FlashConfig and NV
  17              	// [7] Freescale startup_MKL46Z4.s
  18              	//     CMSIS Cortex-M0plus Core Device Startup File for the MKL64Z4
  19              	//     v2.2, 4/12/2013
  20              	//     FCF_ naming convention
  21              	// ---------------------------------------------------------------
  22              	// Author:  R. W. Melton
  23              	// Date:  August 2, 2022
  24              	// ***************************************************************
  25              	// EQUates
  26              	// Standard data masks
  27              	.set BYTE_MASK         ,  0xFF
  28              	.set NIBBLE_MASK       ,  0x0F
  29              	// Standard data sizes (in bits)
  30              	.set BYTE_BITS         ,  8
  31              	.set NIBBLE_BITS       ,  4
  32              	// Architecture data sizes (in bytes)
  33              	.set WORD_SIZE         ,  4  // Cortex-M0+
  34              	.set HALFWORD_SIZE     ,  2  // Cortex-M0+
  35              	// Architecture data masks
  36              	.set HALFWORD_MASK     ,  0xFFFF
  37              	// Return                 
  38              	.set RET_ADDR_T_MASK   ,  1  // Bit 0 of ret. addr. must be
  39              	                          // set for BX, BLX, or POP
  40              	                          // mask in thumb mode
  41              	// ---------------------------------------------------------------
  42              	// Vectors
  43              	.set VECTOR_TABLE_SIZE ,  0x000000C0  // KL46
  44              	.set VECTOR_SIZE       ,  4           // Bytes per vector
  45              	// ---------------------------------------------------------------
  46              	// CPU CONTROL:  Control register
  47              	// 31-2:(reserved)
  48              	//    1:SPSEL=current stack pointer select
  49              	//            0=MSP (main stack pointer) (reset value)
  50              	//            1=PSP (process stack pointer)
  51              	//    0:nPRIV=not privileged
  52              	//         0=privileged (Freescale/NXP "supervisor") (reset value)
  53              	//         1=not privileged (Freescale/NXP "user")
  54              	.set CONTROL_SPSEL_MASK   ,  2
  55              	.set CONTROL_SPSEL_SHIFT  ,  1
  56              	.set CONTROL_nPRIV_MASK   ,  1
  57              	.set CONTROL_nPRIV_SHIFT  ,  0
  58              	// ---------------------------------------------------------------
  59              	// CPU PRIMASK:  Interrupt mask register
  60              	// 31-1:(reserved)
  61              	//    0:PM=prioritizable interrupt mask:
  62              	//         0=all interrupts unmasked (reset value)
  63              	//           (value after CPSIE I instruction)
  64              	//         1=prioritizable interrrupts masked
  65              	//           (value after CPSID I instruction)
  66              	.set PRIMASK_PM_MASK   ,  1
  67              	.set PRIMASK_PM_SHIFT  ,  0
  68              	// ---------------------------------------------------------------
  69              	// CPU PSR:  Program status register
  70              	// Combined APSR, EPSR, and IPSR
  71              	// ----------------------------------------------------------
  72              	// CPU APSR:  Application Program Status Register
  73              	// 31  :N=negative flag
  74              	// 30  :Z=zero flag
  75              	// 29  :C=carry flag
  76              	// 28  :V=overflow flag
  77              	// 27-0:(reserved)
  78              	.set APSR_MASK     ,  0xF0000000
  79              	.set APSR_SHIFT    ,  28
  80              	.set APSR_N_MASK   ,  0x80000000
  81              	.set APSR_N_SHIFT  ,  31
  82              	.set APSR_Z_MASK   ,  0x40000000
  83              	.set APSR_Z_SHIFT  ,  30
  84              	.set APSR_C_MASK   ,  0x20000000
  85              	.set APSR_C_SHIFT  ,  29
  86              	.set APSR_V_MASK   ,  0x10000000
  87              	.set APSR_V_SHIFT  ,  28
  88              	// ----------------------------------------------------------
  89              	// CPU EPSR
  90              	// 31-25:(reserved)
  91              	//    24:T=thumb state bit
  92              	// 23- 0:(reserved)
  93              	.set EPSR_MASK     ,  0x01000000
  94              	.set EPSR_SHIFT    ,  24
  95              	.set EPSR_T_MASK   ,  0x01000000
  96              	.set EPSR_T_SHIFT  ,  24
  97              	// ----------------------------------------------------------
  98              	// CPU IPSR
  99              	// 31-6:(reserved)
 100              	//  5-0:Exception number=number of current exception
 101              	//       0=thread mode
 102              	//       1:(reserved)
 103              	//       2=NMI
 104              	//       3=hard fault
 105              	//       4-10:(reserved)
 106              	//      11=SVCall
 107              	//      12-13:(reserved)
 108              	//      14=PendSV
 109              	//      15=SysTick
 110              	//      16=IRQ0
 111              	//      16-47:IRQ(Exception number - 16)
 112              	//      47=IRQ31
 113              	//      48-63:(reserved)
 114              	.set IPSR_MASK             ,  0x0000003F
 115              	.set IPSR_SHIFT            ,  0
 116              	.set IPSR_EXCEPTION_MASK   ,  0x0000003F
 117              	.set IPSR_EXCEPTION_SHIFT  ,  0
 118              	// ----------------------------------------------------------
 119              	.set PSR_N_MASK           ,  APSR_N_MASK
 120              	.set PSR_N_SHIFT          ,  APSR_N_SHIFT
 121              	.set PSR_Z_MASK           ,  APSR_Z_MASK
 122              	.set PSR_Z_SHIFT          ,  APSR_Z_SHIFT
 123              	.set PSR_C_MASK           ,  APSR_C_MASK
 124              	.set PSR_C_SHIFT          ,  APSR_C_SHIFT
 125              	.set PSR_V_MASK           ,  APSR_V_MASK
 126              	.set PSR_V_SHIFT          ,  APSR_V_SHIFT
 127              	.set PSR_T_MASK           ,  EPSR_T_MASK
 128              	.set PSR_T_SHIFT          ,  EPSR_T_SHIFT
 129              	.set PSR_EXCEPTION_MASK   ,  IPSR_EXCEPTION_MASK
 130              	.set PSR_EXCEPTION_SHIFT  ,  IPSR_EXCEPTION_SHIFT
 131              	// ---------------------------------------------------------------
 132              	// Cortex-M0+ Core
 133              	.set __CM0PLUS_REV           ,  0x0000  // Core revision r0p0
 134              	.set __MPU_PRESENT           ,  0       // Whether MPU is present
 135              	.set __NVIC_PRIO_BITS        ,  2       // Number of NVIC priority bits
 136              	.set __Vendor_SysTickConfig  ,  0       // Whether vendor-specific 
 137              	                                     // SysTickConfig is defined
 138              	.set __VTOR_PRESENT          ,  1       // Whether VTOR is present
 139              	// ---------------------------------------------------------------
 140              	// Interrupt numbers (IRQn)
 141              	// Interrupt vector is 16 + IRQn
 142              	// Core interrupts
 143              	.set NonMaskableInt_IRQn  ,  -14  // Non-maskable interrupt (NMI)
 144              	.set HardFault_IRQn       ,  -13  // Hard fault interrupt
 145              	.set SVCall_IRQn          ,  -5   // Supervisor call interrupt (SVCall)
 146              	.set PendSV_IRQn          ,  -2   // Pendable request for system-level service interrupt
 147              	                               // (PendableSrvReq)
 148              	.set SysTick_IRQn         ,  -1   // System tick timer interrupt (SysTick)
 149              	// --------------------------
 150              	// Device specific interrupts
 151              	.set DMA0_IRQn            ,  0   // DMA channel 0 transfer complete/error interrupt
 152              	.set DMA1_IRQn            ,  1   // DMA channel 1 transfer complete/error interrupt
 153              	.set DMA2_IRQn            ,  2   // DMA channel 2 transfer complete/error interrupt
 154              	.set DMA3_IRQn            ,  3   // DMA channel 3 transfer complete/error interrupt
 155              	.set Reserved20_IRQn      ,  4   // Reserved interrupt 20
 156              	.set FTFA_IRQn            ,  5   // FTFA command complete/read collision interrupt
 157              	.set LVD_LVW_IRQn         ,  6   // Low-voltage detect, low-voltage warning interrupt
 158              	.set LLW_IRQn             ,  7   // Low leakage wakeup interrupt
 159              	.set I2C0_IRQn            ,  8   // I2C0 interrupt
 160              	.set Reserved25_IRQn      ,  9   // Reserved interrupt 25
 161              	.set SPI0_IRQn            ,  10  // SPI0 interrupt
 162              	.set Reserved27_IRQn      ,  11  // Reserved interrupt 27
 163              	.set UART0_IRQn           ,  12  // UART0 status/error interrupt
 164              	.set Reserved29_IRQn      ,  13  // Reserved interrupt 29
 165              	.set Reserved30_IRQn      ,  14  // Reserved interrupt 30
 166              	.set ADC0_IRQn            ,  15  // ADC0 interrupt
 167              	.set CMP0_IRQn            ,  16  // CMP0 interrupt
 168              	.set TPM0_IRQn            ,  17  // TPM0 fault, overflow, and channels interrupt
 169              	.set TPM1_IRQn            ,  18  // TPM1 fault, overflow, and channels interrupt
 170              	.set Reserved35_IRQn      ,  19  // Reserved interrupt 35
 171              	.set RTC_IRQn             ,  20  // RTC alarm interrupt
 172              	.set RTC_Seconds_IRQn     ,  21  // RTC seconds interrupt
 173              	.set PIT_IRQn             ,  22  // PIT interrupt
 174              	.set Reserved39_IRQn      ,  23  // Reserved interrupt 39
 175              	.set Reserved40_IRQn      ,  24  // Reserved interrupt 40
 176              	.set DAC0_IRQn            ,  25  // DAC0 interrupt
 177              	.set TSI0_IRQn            ,  26  // TSI0 interrupt
 178              	.set MCG_IRQn             ,  27  // MCG interrupt
 179              	.set LPTimer_IRQn         ,  28  // LPTMR0 interrupt
 180              	.set Reserved45_IRQn      ,  29  // Reserved interrupt 45
 181              	.set PORTA_IRQn           ,  30  // Port A interrupt
 182              	.set PORTB_IRQn           ,  31  // Port B interrupt
 183              	// ---------------------------------------------------------------
 184              	// Memory map major version
 185              	// (Memory maps with equal major version number are compatible)
 186              	.set MCU_MEM_MAP_VERSION        , 0x0100
 187              	// Memory map minor version
 188              	.set MCU_MEM_MAP_VERSION_MINOR  ,  0x0006
 189              	// ---------------------------------------------------------------
 190              	// ADC
 191              	.set ADC0_BASE        ,  0x4003B000
 192              	// ADC_BASES        EQU  ADC0_BASE
 193              	// ADC_SC1_OFFSET   EQU  0x00
 194              	.set ADC_SC1A_OFFSET  ,  0x00
 195              	.set ADC_SC1B_OFFSET  ,  0x04
 196              	.set ADC_CFG1_OFFSET  ,  0x08
 197              	.set ADC_CFG2_OFFSET  ,  0x0C
 198              	// ADC_R_OFFSET     EQU  0x10
 199              	.set ADC_RA_OFFSET    ,  0x10
 200              	.set ADC_RB_OFFSET    ,  0x14
 201              	.set ADC_CV1_OFFSET   ,  0x18
 202              	.set ADC_CV2_OFFSET   ,  0x1C
 203              	.set ADC_SC2_OFFSET   ,  0x20
 204              	.set ADC_SC3_OFFSET   ,  0x24
 205              	.set ADC_OFS_OFFSET   ,  0x28
 206              	.set ADC_PG_OFFSET    ,  0x2C
 207              	// ADC_RESERVED_0_OFFSET  EQU  0x30
 208              	.set ADC_CLPD_OFFSET  ,  0x34
 209              	.set ADC_CLPS_OFFSET  ,  0x38
 210              	.set ADC_CLP4_OFFSET  ,  0x3C
 211              	.set ADC_CLP3_OFFSET  ,  0x40
 212              	.set ADC_CLP2_OFFSET  ,  0x44
 213              	.set ADC_CLP1_OFFSET  ,  0x48
 214              	.set ADC_CLP0_OFFSET  ,  0x4C
 215              	.set ADC0_CFG1        ,  (ADC0_BASE + ADC_CFG1_OFFSET)
 216              	.set ADC0_CFG2        ,  (ADC0_BASE + ADC_CFG2_OFFSET)
 217              	.set ADC0_CLPD        ,  (ADC0_BASE + ADC_CLPD_OFFSET)
 218              	.set ADC0_CLPS        ,  (ADC0_BASE + ADC_CLPS_OFFSET)
 219              	.set ADC0_CLP0        ,  (ADC0_BASE + ADC_CLP0_OFFSET)
 220              	.set ADC0_CLP1        ,  (ADC0_BASE + ADC_CLP1_OFFSET)
 221              	.set ADC0_CLP2        ,  (ADC0_BASE + ADC_CLP2_OFFSET)
 222              	.set ADC0_CLP3        ,  (ADC0_BASE + ADC_CLP3_OFFSET)
 223              	.set ADC0_CLP4        ,  (ADC0_BASE + ADC_CLP4_OFFSET)
 224              	.set ADC0_CV1         ,  (ADC0_BASE + ADC_CV1_OFFSET)
 225              	.set ADC0_CV2         ,  (ADC0_BASE + ADC_CV2_OFFSET)
 226              	.set ADC0_OFS         ,  (ADC0_BASE + ADC_OFS_OFFSET)
 227              	.set ADC0_PG          ,  (ADC0_BASE + ADC_PG_OFFSET) 
 228              	// ACD0_R           EQU  (ADC0_BASE + ADC_R_OFFSET)  
 229              	.set ADC0_RA          ,  ( ADC0_BASE + ADC_RA_OFFSET)  
 230              	.set ADC0_RB          ,  ( ADC0_BASE + ADC_RB_OFFSET)
 231              	// ADC0_RESERVED_0  EQU  ( ADC0_BASE + ADC_RESERVED_0_OFFSET)
 232              	// ADC0_SC1         EQU  ( ADC0_BASE + ADC_SC1_OFFSET)
 233              	.set ADC0_SC1A        ,  ( ADC0_BASE + ADC_SC1A_OFFSET)
 234              	.set ADC0_SC1B        ,  ( ADC0_BASE + ADC_SC1B_OFFSET)
 235              	.set ADC0_SC2         ,  ( ADC0_BASE + ADC_SC2_OFFSET)
 236              	.set ADC0_SC3         ,  ( ADC0_BASE + ADC_SC3_OFFSET)
 237              	// ---------------------------------------------------------------
 238              	// ADC_CFG1:  ADC configuration register 1
 239              	// 31-8:(reserved):read-only:0
 240              	//    7:ADLPC=ADC low-power configuration
 241              	//  6-5:ADIV=ADC clock divide select
 242              	//      Internal ADC clock = input clock / 2^ADIV
 243              	//    4:ADLSMP=ADC long sample time configuration
 244              	//             0=short
 245              	//             1=long
 246              	//  3-2:MODE=conversion mode selection
 247              	//           00=single-ended 8-bit conversion
 248              	//           01=single-ended 12-bit conversion
 249              	//           10=single-ended 10-bit conversion
 250              	//           11=(reserved; do not set this value)
 251              	//  1-0:ADICLK=ADC input clock select
 252              	//           00=bus clock
 253              	//           01=bus clock / 2
 254              	//           10=alternate clock (ALTCLK)
 255              	//           11=asynchronous clock (ADACK)
 256              	.set ADC_CFG1_ADLPC_MASK   ,  0x80
 257              	.set ADC_CFG1_ADLPC_SHIFT  ,  7
 258              	.set ADC_CFG1_ADIV_MASK    ,  0x60
 259              	.set ADC_CFG1_ADIV_SHIFT   ,  5
 260              	.set ADC_CFG1_ADLSMP_MASK  ,  0x10
 261              	.set ADC_CFG1_ADLSMP_SHIFT ,  4
 262              	.set ADC_CFG1_MODE_MASK    ,  0x0C
 263              	.set ADC_CFG1_MODE_SHIFT   ,  2
 264              	.set ADC_CFG1_ADICLK_MASK  ,  0x03
 265              	.set ADC_CFG1_ADICLK_SHIFT ,  0
 266              	// ---------------------------------------------------------------
 267              	// ADC_CFG2:  ADC configuration register 2
 268              	// 31-8:(reserved):read-only:0
 269              	//  7-5:(reserved):read-only:0
 270              	//    4:MUXSEL=ADC mux select
 271              	//             0=ADxxA channels are selected
 272              	//             1=ADxxB channels are selected
 273              	//    3:ADACKEN=ADC asynchronous clock output enable
 274              	//              0=asynchronous clock determined by ACD0_CFG1.ADICLK 
 275              	//              1=asynchronous clock enabled
 276              	//    2:ADHSC=ADC high-speed configuration
 277              	//            0=normal conversion
 278              	//            1=high-speed conversion (only 2 additional ADK cycles)
 279              	//  1-0:ADLSTS=ADC long sample time select (ADK cycles)
 280              	//           00=default longest sample time:  
 281              	//              24 total ADK cycles (20 extra)
 282              	//           01=16 total ADK cycles (12 extra)
 283              	//           10=10 total ADK cycles (6 extra)
 284              	//           11=6 total ADK cycles (2 extra)
 285              	.set ADC_CFG2_MUXSEL_MASK    ,  0x10
 286              	.set ADC_CFG2_MUXSEL_SHIFT   ,  4
 287              	.set ADC_CFG2_ADACKEN_MASK   ,  0x08
 288              	.set ADC_CFG2_ADACKEN_SHIFT  ,  3
 289              	.set ADC_CFG2_ADHSC_MASK     ,  0x04
 290              	.set ADC_CFG2_ADHSC_SHIFT    ,  2
 291              	.set ADC_CFG2_ADLSTS_MASK    ,  0x03
 292              	.set ADC_CFG2_ADLSTS_SHIFT   ,  0
 293              	// ---------------------------------------------------------------
 294              	// ADC_CLPD:  ADC plus-side general calibration value register D
 295              	// 31-6:(reserved):read-only:0
 296              	//  5-0:CLPD=calibration value
 297              	.set ADC_CLPD_MASK   ,  0x3F
 298              	.set ADC_CLPD_SHIFT  ,  0
 299              	// ---------------------------------------------------------------
 300              	// ADC_CLPS:  ADC plus-side general calibration value register S
 301              	// 31-6:(reserved):read-only:0
 302              	//  5-0:CLPS=calibration value
 303              	.set ADC_CLPS_MASK   ,  0x3F
 304              	.set ADC_CLPS_SHIFT  ,  0
 305              	// ---------------------------------------------------------------
 306              	// ADC_CLP0:  ADC plus-side general calibration value register 0
 307              	// 31-6:(reserved):read-only:0
 308              	//  5-0:CLP0=calibration value
 309              	.set ADC_CLP0_MASK   ,  0x3F
 310              	.set ADC_CLP0_SHIFT  ,  0
 311              	// ---------------------------------------------------------------
 312              	// ADC_CLP1:  ADC plus-side general calibration value register 1
 313              	// 31-7:(reserved):read-only:0
 314              	//  6-0:CLP1=calibration value
 315              	.set ADC_CLP1_MASK   ,  0x7F
 316              	.set ADC_CLP1_SHIFT  ,  0
 317              	// ---------------------------------------------------------------
 318              	// ADC_CLP2:  ADC plus-side general calibration value register 2
 319              	// 31-8:(reserved):read-only:0
 320              	//  7-0:CLP2=calibration value
 321              	.set ADC_CLP2_MASK   ,  0xFF
 322              	.set ADC_CLP2_SHIFT  ,  0
 323              	// ---------------------------------------------------------------
 324              	// ADC_CLP3:  ADC plus-side general calibration value register 3
 325              	// 31-9:(reserved):read-only:0
 326              	//  8-0:CLP3=calibration value
 327              	.set ADC_CLP3_MASK   ,  0x1FF
 328              	.set ADC_CLP3_SHIFT  ,  0
 329              	// ---------------------------------------------------------------
 330              	// ADC_CLP4:  ADC plus-side general calibration value register 4
 331              	// 31-10:(reserved):read-only:0
 332              	//  9- 0:CLP4=calibration value
 333              	.set ADC_CLP4_MASK   ,  0x3FF
 334              	.set ADC_CLP4_SHIFT  ,  0
 335              	// ---------------------------------------------------------------
 336              	// ADC_CVn:  ADC channel n compare value register
 337              	// CV1 used to compare result when ADC_SC2.ACFE=1
 338              	// CV2 used to compare result when ADC_SC2.ACREN=1
 339              	// 31-16:(reserved):read-only:0
 340              	// 15- 0:compare value (zero-extended to 16 bits,
 341              	//                      consistent with format of ACD_Rn)
 342              	.set ADC_CV_MASK   ,  0xFFFF
 343              	.set ADC_CV_SHIFT  ,  0
 344              	// ---------------------------------------------------------------
 345              	// ADC_OFS:  ADC offset correction register
 346              	// 31-16:(reserved):read-only:0
 347              	// 15- 0:OFS=offset error correction value
 348              	.set ADC_OFS_MASK   ,  0xFFFF
 349              	.set ADC_OFS_SHIFT  ,  0
 350              	// ---------------------------------------------------------------
 351              	// ADC_PG:  ADC plus-side gain register
 352              	// 31-16:(reserved):read-only:0
 353              	// 15- 0:PG=plus-side gain
 354              	.set ADC_PG_MASK   ,  0xFFFF
 355              	.set ADC_PG_SHIFT  ,  0
 356              	// ---------------------------------------------------------------
 357              	// ADC_Rn:  ADC channel n data result register
 358              	// 31-16:(reserved):read-only:0
 359              	// 15- 0:data result (zero-extended to 16 bits)
 360              	.set ADC_R_D_MASK   ,  0xFFFF
 361              	.set ADC_R_D_SHIFT  ,  0
 362              	// ---------------------------------------------------------------
 363              	// ADC_SC1n:  ADC channel n status and control register 1
 364              	// 31-8:(reserved):read-only:0
 365              	//    7:COCO=conversion complete flag (read-only)
 366              	//    6:AIEN=ADC interrupt enabled
 367              	//    5:(reserved)
 368              	//  4-0:ADCH=ADC input channel select
 369              	//           00000=AD0
 370              	//           00001=AD1
 371              	//           00010=AD2
 372              	//           00011=AD3
 373              	//           00100=AD4
 374              	//           00101=AD5 (12-bit DAC0 Output)
 375              	//           00110=AD6
 376              	//           00111=AD7
 377              	//           01000=AD8
 378              	//           01001=AD9
 379              	//           01010=AD10
 380              	//           01011=AD11
 381              	//           01100=AD12
 382              	//           01101=AD13
 383              	//           01110=(reserved)
 384              	//           01111=(reserved)
 385              	//           10000=(reserved)
 386              	//           10001=(reserved)
 387              	//           10010=(reserved)
 388              	//           10011=(reserved)
 389              	//           10100=(reserved)
 390              	//           10101=(reserved)
 391              	//           10110=(reserved)
 392              	//           10111=(reserved)
 393              	//           11000=(reserved)
 394              	//           11001=(reserved)
 395              	//           11010=temp sensor (single-ended)
 396              	//           11011=bandgap
 397              	//           11100=(reserved)
 398              	//           11101=VREFSH
 399              	//           11110=VREFSL
 400              	//           11111=disabled
 401              	.set ADC_SC1_COCO_MASK   ,  0x80
 402              	.set ADC_SC1_COCO_SHIFT  ,  7
 403              	.set ADC_SC1_AIEN_MASK   ,  0x40
 404              	.set ADC_SC1_AIEN_SHIFT  ,  6
 405              	.set ADC_SC1_ADCH_MASK   ,  0x1F
 406              	.set ADC_SC1_ADCH_SHIFT  ,  0
 407              	// ---------------------------------------------------------------
 408              	// ADC_SC2:  ADC status and control register 2
 409              	// 31-8:(reserved):read-only:0
 410              	//    7:ADACT=ADC conversion active
 411              	//    6:ADTRG=ADC conversion trigger select
 412              	//            0=software trigger
 413              	//            1=hardware trigger
 414              	//    5:ACFE=ADC compare function enable
 415              	//    4:ACFGT=ADC compare function greater than enable
 416              	//            based on values in ADC_CV1 and ADC_CV2
 417              	//            0=configure less than threshold and non-inclusive range
 418              	//            1=configure greater than threshold and non-inclusive range
 419              	//    3:ACREN=ADC compare function range enable
 420              	//            0=disabled; only ADC_CV1 compared
 421              	//            1=enabled; both ADC_CV1 and ADC_CV2 compared
 422              	//    2:DMAEN=DMA enable
 423              	//  1-0:REFSEL=voltage reference selection
 424              	//             00=default:VREFH and VREFL
 425              	//             01=alternative:VALTH and VALTL
 426              	//             10=(reserved)
 427              	//             11=(reserved)
 428              	.set ADC_SC2_ADACT_MASK    ,  0x80
 429              	.set ADC_SC2_ADACT_SHIFT   ,  7
 430              	.set ADC_SC2_ADTRG_MASK    ,  0x40
 431              	.set ADC_SC2_ADTRG_SHIFT   ,  6
 432              	.set ADC_SC2_ACFE_MASK     ,  0x20
 433              	.set ADC_SC2_ACFE_SHIFT    ,  5
 434              	.set ADC_SC2_ACFGT_MASK    ,  0x10
 435              	.set ADC_SC2_ACFGT_SHIFT   ,  4
 436              	.set ADC_SC2_ACREN_MASK    ,  0x08
 437              	.set ADC_SC2_ACREN_SHIFT   ,  3
 438              	.set ADC_SC2_DMAEN_MASK    ,  0x04
 439              	.set ADC_SC2_DMAEN_SHIFT   ,  2
 440              	.set ADC_SC2_REFSEL_MASK   ,  0x03
 441              	.set ADC_SC2_REFSEL_SHIFT  ,  0
 442              	// ---------------------------------------------------------------
 443              	// ADC_SC3:  ADC status and control register 3
 444              	// 31-8:(reserved):read-only:0
 445              	//    7:CAL=calibration
 446              	//          write:0=(no effect)
 447              	//                1=start calibration sequence
 448              	//          read:0=calibration sequence complete
 449              	//               1=calibration sequence in progress
 450              	//    6:CALF=calibration failed flag
 451              	//  5-4:(reserved):read-only:0
 452              	//    3:ADC=ADC continuous conversion enable (if ADC_SC3.AVGE = 1)
 453              	//    2:AVGE=hardware average enable
 454              	//  1-0:AVGS=hardware average select:  2^(2+AVGS) samples
 455              	.set ADC_SC3_CAL_MASK    ,  0x80
 456              	.set ADC_SC3_CAL_SHIFT   ,  7
 457              	.set ADC_SC3_CALF_MASK   ,  0x40
 458              	.set ADC_SC3_CALF_SHIFT  ,  6
 459              	.set ADC_SC3_ADCO_MASK   ,  0x08
 460              	.set ADC_SC3_ADCO_SHIFT  ,  3
 461              	.set ADC_SC3_AVGE_MASK   ,  0x04
 462              	.set ADC_SC3_AVGE_SHIFT  ,  2
 463              	.set ADC_SC3_AVGS_MASK   ,  0x03
 464              	.set ADC_SC3_AVGS_SHIFT  ,  0
 465              	// ---------------------------------------------------------------
 466              	// CMP
 467              	.set CMP0_BASE          ,  0x40073000
 468              	// CMP_BASES          EQU  CMP0_BASE
 469              	.set CMP0_CR0_OFFSET    ,  0x00
 470              	.set CMP0_CR1_OFFSET    ,  0x01
 471              	.set CMP0_FPR_OFFSET    ,  0x02
 472              	.set CMP0_SCR_OFFSET    ,  0x03
 473              	.set CMP0_DACCR_OFFSET  ,  0x04
 474              	.set CMP0_MUXCR_OFFSET  ,  0x05
 475              	.set CMP0_CR0           ,  (CMP0_BASE + CMP0_CR0_OFFSET)
 476              	.set CMP0_CR1           ,  (CMP0_BASE + CMP0_CR1_OFFSET)
 477              	.set CMP0_FPR           ,  (CMP0_BASE + CMP0_FPR_OFFSET)
 478              	.set CMP0_SCR           ,  (CMP0_BASE + CMP0_SCR_OFFSET)
 479              	.set CMP0_DACCR         ,  (CMP0_BASE + CMP0_DACCR_OFFSET)
 480              	.set CMP0_MUXCR         ,  (CMP0_BASE + CMP0_MUXCR_OFFSET)
 481              	// ---------------------------------------------------------------
 482              	// CMP0_CR0:  CMP0 control register 0 (0x00)
 483              	//   7:(reserved):read-only:0
 484              	// 6-4:FILTER_CNT=filter sample count (00)
 485              	//   3:(reserved):read-only:0
 486              	//   2:(reserved):read-only:0
 487              	// 1-0:HYSTCTR=comparator hard block hysteresis control (00)
 488              	.set CMP_CR0_HYSTCTR_MASK      ,  0x3
 489              	.set CMP_CR0_HYSTCTR_SHIFT     ,  0
 490              	.set CMP_CR0_FILTER_CNT_MASK   ,  0x70
 491              	.set CMP_CR0_FILTER_CNT_SHIFT  ,  4
 492              	// ---------------------------------------------------------------
 493              	// CMP0_CR1:  CMP0 control register 1 (0x00)
 494              	// 7:SE=sample enable (0)
 495              	// 6:WE=windowing enable (0)
 496              	// 5:TRIGM=trigger mode enable (0)
 497              	// 4:PMODE=power mode select (0)
 498              	//         0=low-speed comparison mode
 499              	//         1=high-speed comparison mode
 500              	// 3:INV=comparator invert (0)
 501              	// 2:COS=comparator output select (0)
 502              	//       0=filtered output COUT
 503              	//       1=unfiltered output COUTA
 504              	// 1:OPE=comparator output pin enable (0)
 505              	// 0:EN=comparator module enable (0)
 506              	.set CMP_CR1_EN_MASK      ,  0x1
 507              	.set CMP_CR1_EN_SHIFT     ,  0
 508              	.set CMP_CR1_OPE_MASK     ,  0x2
 509              	.set CMP_CR1_OPE_SHIFT    ,  1
 510              	.set CMP_CR1_COS_MASK     ,  0x4
 511              	.set CMP_CR1_COS_SHIFT    ,  2
 512              	.set CMP_CR1_INV_MASK     ,  0x8
 513              	.set CMP_CR1_INV_SHIFT    ,  3
 514              	.set CMP_CR1_PMODE_MASK   ,  0x10
 515              	.set CMP_CR1_PMODE_SHIFT  ,  4
 516              	.set CMP_CR1_TRIGM_MASK   ,  0x20
 517              	.set CMP_CR1_TRIGM_SHIFT  ,  5
 518              	.set CMP_CR1_WE_MASK      ,  0x40
 519              	.set CMP_CR1_WE_SHIFT     ,  6
 520              	.set CMP_CR1_SE_MASK      ,  0x80
 521              	.set CMP_CR1_SE_SHIFT     ,  7
 522              	// ---------------------------------------------------------------
 523              	// CMP0_FPR=CMP filter period register (0x00)
 524              	// 7-0:FILT_PER=CMP filter period register (0x00)
 525              	.set CMP_FPR_FILT_PER_MASK   ,  0xFF
 526              	.set CMP_FPR_FILT_PER_SHIFT  ,  0
 527              	// ---------------------------------------------------------------
 528              	// CMP0_SCR=CMP status and control register (0x00)
 529              	// 7:(reserved):read-only:0
 530              	// 6:DMAEN=DMA enable control (0)
 531              	// 5:(reserved):read-only:0
 532              	// 4:IER=comparator interrupt enable rising (0)
 533              	// 3:IEF=comparator interrupt enable falling (0)
 534              	// 2:CFR=analog comparator flag rising: w1c (0)
 535              	// 1:CFF=analog comparator flag falling: w1c (0)
 536              	// 0:COUT=analog comparator output:  read-only (0)
 537              	.set CMP_SCR_COUT_MASK    ,  0x1
 538              	.set CMP_SCR_COUT_SHIFT   ,  0
 539              	.set CMP_SCR_CFF_MASK     ,  0x2
 540              	.set CMP_SCR_CFF_SHIFT    ,  1
 541              	.set CMP_SCR_CFR_MASK     ,  0x4
 542              	.set CMP_SCR_CFR_SHIFT    ,  2
 543              	.set CMP_SCR_IEF_MASK     ,  0x8
 544              	.set CMP_SCR_IEF_SHIFT    ,  3
 545              	.set CMP_SCR_IER_MASK     ,  0x10
 546              	.set CMP_SCR_IER_SHIFT    ,  4
 547              	.set CMP_SCR_DMAEN_MASK   ,  0x40
 548              	.set CMP_SCR_DMAEN_SHIFT  ,  6
 549              	// ---------------------------------------------------------------
 550              	// CMP0_DACCR=DAC control register (0x00)
 551              	//   7:DACEN=DAC enable (0)
 552              	//   6:VRSEL=supply voltage reference source select (0)
 553              	//           0=Selected from mux by Vin1
 554              	//           1=Selected from mux by Vin2
 555              	// 5-0:VOSEL=DAC output voltage select (00000)
 556              	//           DAC0 = (Vin / 64) x (VOSEL[5:0] + 1)
 557              	.set CMP_DACCR_VOSEL_MASK   ,  0x3F
 558              	.set CMP_DACCR_VOSEL_SHIFT  ,  0
 559              	.set CMP_DACCR_VRSEL_MASK   ,  0x40
 560              	.set CMP_DACCR_VRSEL_SHIFT  ,  6
 561              	.set CMP_DACCR_DACEN_MASK   ,  0x80
 562              	.set CMP_DACCR_DACEN_SHIFT  ,  7
 563              	// ---------------------------------------------------------------
 564              	// CMP0_MUXCR=MUX control register (0x00)
 565              	//   7:PSTM=pass through mode enable (0)
 566              	//   6:(reserved):read-only:0
 567              	// 5-3:PSEL=plus input mux control (000)
 568              	//          selects IN[PSEL]
 569              	// 2-0:MSEL=minus input mux control (000)
 570              	//          selects IN[MSEL]
 571              	.set CMP_MUXCR_MSEL_MASK   ,  0x7
 572              	.set CMP_MUXCR_MSEL_SHIFT  ,  0
 573              	.set CMP_MUXCR_PSEL_MASK   ,  0x38
 574              	.set CMP_MUXCR_PSEL_SHIFT  ,  3
 575              	.set CMP_MUXCR_PSTM_MASK   ,  0x80
 576              	.set CMP_MUXCR_PSTM_SHIFT  ,  7
 577              	// ---------------------------------------------------------------
 578              	// DAC
 579              	.set DAC0_BASE          ,  0x4003F000
 580              	// DAC_BASES          EQU  DAC0_BASE
 581              	// DAC0_DAT_OFFSET    EQU  0x00
 582              	.set DAC0_DAT0L_OFFSET  ,  0x00
 583              	.set DAC0_DAT0H_OFFSET  ,  0x01
 584              	.set DAC0_DAT1L_OFFSET  ,  0x02
 585              	.set DAC0_DAT1H_OFFSET  ,  0x03
 586              	// DAC0_RESERVED_0_OFFSET  EQU  0x04
 587              	.set DAC0_SR_OFFSET     ,  0x20
 588              	.set DAC0_C0_OFFSET     ,  0x21
 589              	.set DAC0_C1_OFFSET     ,  0x22
 590              	.set DAC0_C2_OFFSET     ,  0x23
 591              	// DAC0_DAT           EQU  (DAC0_BASE + DAC0_DAT_OFFSET)
 592              	.set DAC0_DAT0L         ,  (DAC0_BASE + DAC0_DAT0L_OFFSET)
 593              	.set DAC0_DAT0H         ,  (DAC0_BASE + DAC0_DAT0H_OFFSET)
 594              	.set DAC0_DAT1L         ,  (DAC0_BASE + DAC0_DAT1L_OFFSET)
 595              	.set DAC0_DAT1H         ,  (DAC0_BASE + DAC0_DAT1H_OFFSET)
 596              	// DAC0_RESERVED_0    EQU  (DAC0_BASE + DAC0_RESERVED_0_OFFSET)
 597              	.set DAC0_SR            ,  (DAC0_BASE + DAC0_SR_OFFSET)
 598              	.set DAC0_C0            ,  (DAC0_BASE + DAC0_C0_OFFSET)
 599              	.set DAC0_C1            ,  (DAC0_BASE + DAC0_C1_OFFSET)
 600              	.set DAC0_C2            ,  (DAC0_BASE + DAC0_C2_OFFSET)
 601              	// ---------------------------------------------------------------
 602              	// DAC_DAT0H:  DAC data high register 0
 603              	// If buffer not enabled, Vout = Vin * (1 + DATA[11:0])/4096.
 604              	// 7-4:(reserved):read-only:0
 605              	// 3-0:DATA1=DATA[11:8] (0000)
 606              	.set DAC_DAT0H_MASK   ,  0x0F
 607              	.set DAC_DAT0H_SHIFT  ,  0
 608              	// ---------------------------------------------------------------
 609              	// DAC_DAT0L:  DAC data low register 0
 610              	// If buffer not enabled, Vout = Vin * (1 + DATA[11:0])/4096.
 611              	// 7-0:DATA0=DATA[7:0] (00000000)
 612              	.set DAC_DAT0L_MASK   ,  0xFF
 613              	.set DAC_DAT0L_SHIFT  ,  0
 614              	// ---------------------------------------------------------------
 615              	// DAC_DAT1H:  DAC data high register 1
 616              	// If buffer not enabled, Vout = Vin * (1 + DATA[11:0])/4096.
 617              	// 7-4:(reserved):read-only:0
 618              	// 3-0:DATA1=DATA[11:8] (0000)
 619              	.set DAC_DAT1H_MASK   ,  0x0F
 620              	.set DAC_DAT1H_SHIFT  ,  0
 621              	// ---------------------------------------------------------------
 622              	// DAC_DAT1L:  DAC data low register 1
 623              	// If buffer not enabled, Vout = Vin * (1 + DATA[11:0])/4096.
 624              	// 7-0:DATA0=DATA[7:0] (00000000)
 625              	.set DAC_DAT1L_MASK   ,  0xFF
 626              	.set DAC_DAT1L_SHIFT  ,  0
 627              	// ;---------------------------------------------------------------
 628              	// ;DAC_DATH:  DAC data high registers
 629              	// ;If buffer not enabled, Vout = Vin * (1 + DATA[11:0])/4096.
 630              	// ;7-4:(reserved):read-only:0
 631              	// ;3-0:DATA1=DATA[11:8] (0000)
 632              	// DAC_DATH_DATA0_MASK   EQU  0x0F
 633              	// DAC_DATH_DATA0_SHIFT  EQU  0
 634              	// ;---------------------------------------------------------------
 635              	// ;DAC_DATL:  DAC data low registers
 636              	// ;If buffer not enabled, Vout = Vin * (1 + DATA[11:0])/4096.
 637              	// ;7-0:DATA0=DATA[7:0] (00000000)
 638              	// DAC_DATL_DATA0_MASK   EQU  0xFF
 639              	// DAC_DATL_DATA0_SHIFT  EQU  0
 640              	// ---------------------------------------------------------------
 641              	// DAC_C0:  DAC control register 0
 642              	// 7:DACEN=DAC enable (0)
 643              	// 6:DACRFS=DAC reference select (0)
 644              	//          0:DACREF_1=VREFH
 645              	//          1:DACREF_2=VDDA (best for ADC operation)
 646              	// 5:DACTRGSEL=DAC trigger select (0)
 647              	//             0:HW
 648              	//             1:SW
 649              	// 4:DACSWTRG=DAC software trigger (0)
 650              	//            active-high write-only field that reads 0
 651              	//            DACBFEN & DACTRGSEL:  writing 1 advances buffer pointer
 652              	// 3:LPEN=DAC low power control (0)
 653              	//        0:high-power mode
 654              	//        1:low-power mode
 655              	// 2:(reserved):read-only:0
 656              	// 1:DACBTIEN=DAC buffer read pointer top flag interrupt enable (0)
 657              	// 0:DACBBIEN=DAC buffer read pointer bottom flag interrupt enable (0)
 658              	.set DAC_C0_DACEN_MASK       ,  0x80
 659              	.set DAC_C0_DACEN_SHIFT      ,  7
 660              	.set DAC_C0_DACRFS_MASK      ,  0x40
 661              	.set DAC_C0_DACRFS_SHIFT     ,  6
 662              	.set DAC_C0_DACTRGSEL_MASK   ,  0x20
 663              	.set DAC_C0_DACTRGSEL_SHIFT  ,  5
 664              	.set DAC_C0_DACSWTRG_MASK    ,  0x10
 665              	.set DAC_C0_DACSWTRG_SHIFT   ,  4
 666              	.set DAC_C0_LPEN_MASK        ,  0x08
 667              	.set DAC_C0_LPEN_SHIFT       ,  3
 668              	.set DAC_C0_DACBTIEN_MASK    ,  0x02
 669              	.set DAC_C0_DACBTIEN_SHIFT   ,  1
 670              	.set DAC_C0_DACBBIEN_MASK    ,  0x01
 671              	.set DAC_C0_DACBBIEN_SHIFT   ,  0
 672              	// ---------------------------------------------------------------
 673              	// DAC_C1:  DAC control register 1
 674              	//   7:DMAEN=DMA enable select (0)
 675              	// 6-3:(reserved):read-only:0000
 676              	//   2:DACBFMD=DAC buffer work mode select (0)
 677              	//             0:normal
 678              	//             1:one-time scan
 679              	//   1:(reserved):read-only:0
 680              	//   0:DACBFEN=DAC buffer enable (0)
 681              	//             0:disabled:data in first word of buffer
 682              	//             1:enabled:read pointer points to data
 683              	.set DAC_C1_DMAEN_MASK       ,  0x80
 684              	.set DAC_C1_DMAEN_SHIFT      ,  7
 685              	.set DAC_C1_DACBFMD_MASK     ,  0x04
 686              	.set DAC_C1_DACBFMD_SHIFT    ,  2
 687              	.set DAC_C1_DACBFEN_MASK     ,  0x01
 688              	.set DAC_C1_DACBFEN_SHIFT    ,  0
 689              	// ---------------------------------------------------------------
 690              	// DAC_C2:  DAC control register 2
 691              	// 7-5:(reserved):read-only:0
 692              	//   4:DACBFRP=DAC buffer read pointer (0)
 693              	// 3-1:(reserved):read-only:0
 694              	//   0:DACBFUP=DAC buffer read upper limit (1)
 695              	.set DAC_C2_DACBFRP_MASK   ,  0x10
 696              	.set DAC_C2_DACBFRP_SHIFT  ,  4
 697              	.set DAC_C2_DACBFUP_MASK   ,  0x01
 698              	.set DAC_C2_DACBFUP_SHIFT  ,  0
 699              	// ---------------------------------------------------------------
 700              	// DAC_SR:  DAC status register
 701              	// Writing 0 clears a field; writing 1 has no effect.
 702              	// 7-2:(reserved):read-only:000000
 703              	// 1:DACBFRPTF=DAC buffer read pointer top position flag (1)
 704              	//             Indicates whether pointer is zero
 705              	// 0:DACBFRPBF=DAC buffer read pointer bottom position flag (0)
 706              	//             Indicates whether pointer is equal to DAC0_C2.DACBFUP.
 707              	.set DAC_SR_DACBFRPTF_MASK   , 0x02
 708              	.set DAC_SR_DACBFRPTF_SHIFT  , 1
 709              	.set DAC_SR_DACBFRPBF_MASK   , 0x01
 710              	.set DAC_SR_DACBFRPBF_SHIFT  , 0
 711              	// ---------------------------------------------------------------
 712              	// Flash Configuration Field (FCF) 0x400-0x40F
 713              	// Following [6, 7]
 714              	// 16-byte flash configuration field that stores default protection settings
 715              	// (loaded on reset) and security information that allows the MCU to 
 716              	// restrict acces to the FTFL module.
 717              	// FCF Backdoor Comparison Key
 718              	// 8 bytes from 0x400-0x407
 719              	// -----------------------------------------------------
 720              	// FCF Backdoor Comparison Key 0
 721              	// 7-0:Backdoor Key 0
 722              	.set FCF_BACKDOOR_KEY0  ,  0xFF
 723              	.set BackDoorK0         ,  0xFF
 724              	// -----------------------------------------------------
 725              	// FCF Backdoor Comparison Key 1
 726              	// 7-0:Backdoor Key 1
 727              	.set FCF_BACKDOOR_KEY1  ,  0xFF
 728              	.set BackDoorK1         ,  0xFF
 729              	// -----------------------------------------------------
 730              	// FCF Backdoor Comparison Key 2
 731              	// 7-0:Backdoor Key 2
 732              	.set FCF_BACKDOOR_KEY2  ,  0xFF
 733              	.set BackDoorK2         ,  0xFF
 734              	// -----------------------------------------------------
 735              	// FCF Backdoor Comparison Key 3
 736              	// 7-0:Backdoor Key 3
 737              	.set FCF_BACKDOOR_KEY3  ,  0xFF
 738              	.set BackDoorK3         ,  0xFF
 739              	// -----------------------------------------------------
 740              	// FCF Backdoor Comparison Key 4
 741              	// 7-0:Backdoor Key 4
 742              	.set FCF_BACKDOOR_KEY4  ,  0xFF
 743              	.set BackDoorK4         ,  0xFF
 744              	// -----------------------------------------------------
 745              	// FCF Backdoor Comparison Key 5
 746              	// 7-0:Backdoor Key 5
 747              	.set FCF_BACKDOOR_KEY5  ,  0xFF
 748              	.set BackDoorK5         ,  0xFF
 749              	// -----------------------------------------------------
 750              	// FCF Backdoor Comparison Key 6
 751              	// 7-0:Backdoor Key 6
 752              	.set FCF_BACKDOOR_KEY6  ,  0xFF
 753              	.set BackDoorK6         ,  0xFF
 754              	// -----------------------------------------------------
 755              	// FCF Backdoor Comparison Key 7
 756              	// 7-0:Backdoor Key 7
 757              	.set FCF_BACKDOOR_KEY7  ,  0xFF
 758              	.set BackDoorK7         ,  0xFF
 759              	// -----------------------------------------------------
 760              	// FCF Flash nonvolatile option byte (FCF_FOPT)
 761              	// Allows user to customize operation of the MCU at boot time.
 762              	// 7-6:11:(reserved)
 763              	//   5: 1:FAST_INIT=fast initialization
 764              	// 4,0:11:LPBOOT=core and system clock divider:  2^(3-LPBOOT)
 765              	//   3: 1:RESET_PIN_CFG=enable reset pin following POR
 766              	//   2: 1:NMI_DIS=Enable NMI
 767              	//   1: 1:(reserved)
 768              	//   0:(see bit 4 above)
 769              	.set FCF_FOPT  ,  0xFF
 770              	.set FOPT      ,  0xFF
 771              	// -----------------------------------------------------
 772              	// FCF Program flash protection bytes (FCF_FPROT)
 773              	// Each program flash region can be protected from program and erase 
 774              	// operation by setting the associated PROT bit.  Each bit protects a 
 775              	// 1/32 region of the program flash memory.
 776              	// FCF FPROT0
 777              	// 7:1:FCF_PROT7=Program flash region 7/32 not protected
 778              	// 6:1:FCF_PROT6=Program flash region 6/32 not protected
 779              	// 5:1:FCF_PROT5=Program flash region 5/32 not protected
 780              	// 4:1:FCF_PROT4=Program flash region 4/32 not protected
 781              	// 3:1:FCF_PROT3=Program flash region 3/32 not protected
 782              	// 2:1:FCF_PROT2=Program flash region 2/32 not protected
 783              	// 1:1:FCF_PROT1=Program flash region 1/32 not protected
 784              	// 0:1:FCF_PROT0=Program flash region 0/32 not protected
 785              	.set FCF_FPROT0  ,  0xFF
 786              	.set nFPROT0     ,  0x00
 787              	.set FPROT0      ,  nFPROT0 ^ 0xFF
 788              	// -----------------------------------------------------
 789              	// FCF FPROT1
 790              	// 7:1:FCF_PROT15=Program flash region 15/32 not protected
 791              	// 6:1:FCF_PROT14=Program flash region 14/32 not protected
 792              	// 5:1:FCF_PROT13=Program flash region 13/32 not protected
 793              	// 4:1:FCF_PROT12=Program flash region 12/32 not protected
 794              	// 3:1:FCF_PROT11=Program flash region 11/32 not protected
 795              	// 2:1:FCF_PROT10=Program flash region 10/32 not protected
 796              	// 1:1:FCF_PROT9=Program flash region 9/32 not protected
 797              	// 0:1:FCF_PROT8=Program flash region 8/32 not protected
 798              	.set FCF_FPROT1  ,  0xFF
 799              	.set nFPROT1     ,  0x00
 800              	.set FPROT1      ,  nFPROT1 ^ 0xFF
 801              	// -----------------------------------------------------
 802              	// FCF FPROT2
 803              	// 7:1:FCF_PROT23=Program flash region 23/32 not protected
 804              	// 6:1:FCF_PROT22=Program flash region 22/32 not protected
 805              	// 5:1:FCF_PROT21=Program flash region 21/32 not protected
 806              	// 4:1:FCF_PROT20=Program flash region 20/32 not protected
 807              	// 3:1:FCF_PROT19=Program flash region 19/32 not protected
 808              	// 2:1:FCF_PROT18=Program flash region 18/32 not protected
 809              	// 1:1:FCF_PROT17=Program flash region 17/32 not protected
 810              	// 0:1:FCF_PROT16=Program flash region 16/32 not protected
 811              	.set FCF_FPROT2  ,  0xFF
 812              	.set nFPROT2     ,  0x00
 813              	.set FPROT2      ,  nFPROT2 ^ 0xFF
 814              	// -----------------------------------------------------
 815              	// FCF FPROT3
 816              	// 7:1:FCF_PROT31=Program flash region 31/32 not protected
 817              	// 6:1:FCF_PROT30=Program flash region 30/32 not protected
 818              	// 5:1:FCF_PROT29=Program flash region 29/32 not protected
 819              	// 4:1:FCF_PROT28=Program flash region 28/32 not protected
 820              	// 3:1:FCF_PROT27=Program flash region 27/32 not protected
 821              	// 2:1:FCF_PROT26=Program flash region 26/32 not protected
 822              	// 1:1:FCF_PROT25=Program flash region 25/32 not protected
 823              	// 0:1:FCF_PROT24=Program flash region 24/32 not protected
 824              	.set FCF_FPROT3  ,  0xFF
 825              	.set nFPROT3     ,  0x00
 826              	.set FPROT3      ,  nFPROT3 ^ 0xFF
 827              	// -----------------------------------------------------
 828              	// FCF Flash security byte (FCF_FSEC)
 829              	// WARNING: If SEC field is configured as "MCU security status is 
 830              	// secure" and MEEN field is configured as "Mass erase is disabled",
 831              	// MCU's security status cannot be set back to unsecure state since 
 832              	// mass erase via the debugger is blocked !!!
 833              	// 7-6:01:KEYEN=backdoor key security enable
 834              	//             :00=Backdoor key access disabled
 835              	//             :01=Backdoor key access disabled (preferred value)
 836              	//             :10=Backdoor key access enabled
 837              	//             :11=Backdoor key access disabled
 838              	// 5-4:11:MEEN=mass erase enable bits
 839              	//            (does not matter if SEC unsecure)
 840              	//            :00=mass erase enabled
 841              	//            :01=mass erase enabled
 842              	//            :10=mass erase disabled
 843              	//            :11=mass erase enabled
 844              	// 3-2:11:FSLACC=Freescale failure analysis access code
 845              	//              (does not matter if SEC unsecure)
 846              	//              :00=Freescale factory access granted
 847              	//              :01=Freescale factory access denied
 848              	//              :10=Freescale factory access denied
 849              	//              :11=Freescale factory access granted
 850              	// 1-0:10:SEC=flash security
 851              	//           :00=MCU secure
 852              	//           :01=MCU secure
 853              	//           :10=MCU unsecure (standard value)
 854              	//           :11=MCU secure
 855              	.set FCF_FSEC  ,  0x7E
 856              	.set FSEC      ,  0xFE
 857              	// ---------------------------------------------------------------
 858              	// Fast (zero wait state) GPIO (FGPIO) or (IOPORT)
 859              	// FGPIOx_PDD:  Port x Data Direction Register
 860              	//   Bit n:  0=Port x pin n configured as input
 861              	//           1=Port x pin n configured as output
 862              	// FGPIOx_PDIR:  Port x Data Input Register
 863              	//   Bit n:  Value read from Port x pin n (if input pin)
 864              	// FGPIOx_PDOR:  Port x Data Output Register
 865              	//   Bit n:  Value written to Port x pin n (if output pin)
 866              	// FGPIOx_PoOR: Port x operation o direction x Register
 867              	//   Operation o:  C=Clear (clear to 0)
 868              	//                 S=Set (set to 1)
 869              	//                 T=Toggle (complement)
 870              	//   Bit n:  0=Port x pin n not affected
 871              	//           1=Port x pin n affected
 872              	.set FGPIO_BASE         ,  0xF80FF000
 873              	.set FGPIO_PDOR_OFFSET  ,  0x00
 874              	.set FGPIO_PSOR_OFFSET  ,  0x04
 875              	.set FGPIO_PCOR_OFFSET  ,  0x08
 876              	.set FGPIO_PTOR_OFFSET  ,  0x0C
 877              	.set FGPIO_PDIR_OFFSET  ,  0x10
 878              	.set FGPIO_PDDR_OFFSET  ,  0x14
 879              	// FGPIOx not present in MKL05Z4.h:  FPTx instead
 880              	// FGPIOx included for compatibility with MKL46Z4.h
 881              	// Fast Port A
 882              	.set FGPIOA_BASE        ,  0xF80FF000
 883              	.set FGPIOA_PDOR        ,  (FGPIOA_BASE + GPIO_PDOR_OFFSET)
 884              	.set FGPIOA_PSOR        ,  (FGPIOA_BASE + GPIO_PSOR_OFFSET)
 885              	.set FGPIOA_PCOR        ,  (FGPIOA_BASE + GPIO_PCOR_OFFSET)
 886              	.set FGPIOA_PTOR        ,  (FGPIOA_BASE + GPIO_PTOR_OFFSET)
 887              	.set FGPIOA_PDIR        ,  (FGPIOA_BASE + GPIO_PDIR_OFFSET)
 888              	.set FGPIOA_PDDR        ,  (FGPIOA_BASE + GPIO_PDDR_OFFSET)
 889              	// Fast Port B
 890              	.set FGPIOB_BASE        ,  0xF80FF040
 891              	.set FGPIOB_PDOR        ,  (FGPIOB_BASE + GPIO_PDOR_OFFSET)
 892              	.set FGPIOB_PSOR        ,  (FGPIOB_BASE + GPIO_PSOR_OFFSET)
 893              	.set FGPIOB_PCOR        ,  (FGPIOB_BASE + GPIO_PCOR_OFFSET)
 894              	.set FGPIOB_PTOR        ,  (FGPIOB_BASE + GPIO_PTOR_OFFSET)
 895              	.set FGPIOB_PDIR        ,  (FGPIOB_BASE + GPIO_PDIR_OFFSET)
 896              	.set FGPIOB_PDDR        ,  (FGPIOB_BASE + GPIO_PDDR_OFFSET)
 897              	// Fast GPIO
 898              	// FGPIO_BASES        EQU  FGPIOA_BASE
 899              	// ---------------------------------------------------------------
 900              	// FPTx not present in MKL46Z4.h
 901              	// Fast (zero wait state) general-purpose input and output (FPTx)
 902              	// FPTx_PDD:  Port x Data Direction Register
 903              	//   Bit n:  0=Port x pin n configured as input
 904              	//           1=Port x pin n configured as output
 905              	// FPTx_PDIR:  Port x Data Input Register
 906              	//   Bit n:  Value read from Port x pin n (if input pin)
 907              	// FPTx_PDOR:  Port x Data Output Register
 908              	//   Bit n:  Value written to Port x pin n (if output pin)
 909              	// FPTx_PoOR: Port x operation o direction x Register
 910              	//   Operation o:  C=Clear (clear to 0)
 911              	//                 S=Set (set to 1)
 912              	//                 T=Toggle (complement)
 913              	//   Bit n:  0=Port x pin n not affected
 914              	//           1=Port x pin n affected
 915              	.set FPT_BASE         ,  0xF80FF000
 916              	.set FPT_PDOR_OFFSET  ,  0x00
 917              	.set FPT_PSOR_OFFSET  ,  0x04
 918              	.set FPT_PCOR_OFFSET  ,  0x08
 919              	.set FPT_PTOR_OFFSET  ,  0x0C
 920              	.set FPT_PDIR_OFFSET  ,  0x10
 921              	.set FPT_PDDR_OFFSET  ,  0x14
 922              	.set FPTA_OFFSET      ,  0x00
 923              	.set FPTB_OFFSET      ,  0x40
 924              	// Fast Port A (FPTA)
 925              	.set FPTA_BASE        ,  0xF80FF000
 926              	.set FPTA_PSOR        ,  (FPTA_BASE + FPT_PSOR_OFFSET)
 927              	.set FPTA_PDOR        ,  (FPTA_BASE + FPT_PDOR_OFFSET)
 928              	.set FPTA_PCOR        ,  (FPTA_BASE + FPT_PCOR_OFFSET)
 929              	.set FPTA_PTOR        ,  (FPTA_BASE + FPT_PTOR_OFFSET)
 930              	.set FPTA_PDIR        ,  (FPTA_BASE + FPT_PDIR_OFFSET)
 931              	.set FPTA_PDDR        ,  (FPTA_BASE + FPT_PDDR_OFFSET)
 932              	// Fast Port B (FPTB)
 933              	.set FPTB_BASE        ,  0xF80FF040
 934              	.set FPTB_PDOR        ,  (FPTB_BASE + FPT_PDOR_OFFSET)
 935              	.set FPTB_PSOR        ,  (FPTB_BASE + FPT_PSOR_OFFSET)
 936              	.set FPTB_PCOR        ,  (FPTB_BASE + FPT_PCOR_OFFSET)
 937              	.set FPTB_PTOR        ,  (FPTB_BASE + FPT_PTOR_OFFSET)
 938              	.set FPTB_PDIR        ,  (FPTB_BASE + FPT_PDIR_OFFSET)
 939              	.set FPTB_PDDR        ,  (FPTB_BASE + FPT_PDDR_OFFSET)
 940              	// ---------------------------------------------------------------
 941              	// Flash configuration field
 942              	// Nonvolatile (NV) Peripheral access layer
 943              	// Following [3]
 944              	.set FTFA_FlashConfig_BASE             ,  0x400
 945              	.set FTFA_FlashConfig_BACKKEY3_OFFSET  ,  0x0
 946              	.set FTFA_FlashConfig_BACKKEY2_OFFSET  ,  0x1
 947              	.set FTFA_FlashConfig_BACKKEY1_OFFSET  ,  0x2
 948              	.set FTFA_FlashConfig_BACKKEY0_OFFSET  ,  0x3
 949              	.set FTFA_FlashConfig_BACKKEY7_OFFSET  ,  0x4
 950              	.set FTFA_FlashConfig_BACKKEY6_OFFSET  ,  0x5
 951              	.set FTFA_FlashConfig_BACKKEY5_OFFSET  ,  0x6
 952              	.set FTFA_FlashConfig_BACKKEY4_OFFSET  ,  0x7
 953              	.set FTFA_FlashConfig_FPROT3_OFFSET    ,  0x8
 954              	.set FTFA_FlashConfig_FPROT2_OFFSET    ,  0x9
 955              	.set FTFA_FlashConfig_FPROT1_OFFSET    ,  0xA
 956              	.set FTFA_FlashConfig_FPROT0_OFFSET    ,  0xB
 957              	.set FTFA_FlashConfig_FSEC_OFFSET      ,  0xC
 958              	.set FTFA_FlashConfig_FOPT_OFFSET      ,  0xD
 959              	.set FTFA_FlashConfig_BACKKEY3         ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_BACKKEY3_OFFSET
 960              	.set FTFA_FlashConfig_BACKKEY2         ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_BACKKEY2_OFFSET
 961              	.set FTFA_FlashConfig_BACKKEY1         ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_BACKKEY1_OFFSET
 962              	.set FTFA_FlashConfig_BACKKEY0         ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_BACKKEY0_OFFSET
 963              	.set FTFA_FlashConfig_BACKKEY7         ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_BACKKEY7_OFFSET
 964              	.set FTFA_FlashConfig_BACKKEY6         ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_BACKKEY6_OFFSET
 965              	.set FTFA_FlashConfig_BACKKEY5         ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_BACKKEY5_OFFSET
 966              	.set FTFA_FlashConfig_BACKKEY4         ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_BACKKEY4_OFFSET
 967              	.set FTFA_FlashConfig_FPROT3           ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_FPROT3_OFFSET)
 968              	.set FTFA_FlashConfig_FPROT2           ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_FPROT2_OFFSET)
 969              	.set FTFA_FlashConfig_FPROT1           ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_FPROT1_OFFSET)
 970              	.set FTFA_FlashConfig_FPROT0           ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_FPROT0_OFFSET)
 971              	.set FTFA_FlashConfig_FSEC             ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_FSEC_OFFSET)
 972              	.set FTFA_FlashConfig_FOPT             ,  (FTFA_FlashConfig_BASE + FTFA_FlashConfig_FOPT_OFFSET)
 973              	// ---------------------------------------------------------------
 974              	// NV FCF Backdoor Comparison Key 3
 975              	.set FTFA_FlashConfig_BACKKEY3_KEY_MASK   ,  0xFF
 976              	.set FTFA_FlashConfig_BACKKEY3_KEY_SHIFT  ,  0
 977              	// ---------------------------------------------------------------
 978              	// NV FCF Backdoor Comparison Key 2
 979              	.set FTFA_FlashConfig_BACKKEY2_KEY_MASK   ,  0xFF
 980              	.set FTFA_FlashConfig_BACKKEY2_KEY_SHIFT  ,  0
 981              	// ---------------------------------------------------------------
 982              	// NV FCF Backdoor Comparison Key 1
 983              	.set FTFA_FlashConfig_BACKKEY1_KEY_MASK   ,  0xFF
 984              	.set FTFA_FlashConfig_BACKKEY1_KEY_SHIFT  ,  0
 985              	// ---------------------------------------------------------------
 986              	// NV FCF Backdoor Comparison Key 0
 987              	.set FTFA_FlashConfig_BACKKEY0_KEY_MASK   ,  0xFF
 988              	.set FTFA_FlashConfig_BACKKEY0_KEY_SHIFT  ,  0
 989              	// ---------------------------------------------------------------
 990              	// NV FCF Backdoor Comparison Key 7
 991              	.set FTFA_FlashConfig_BACKKEY7_KEY_MASK   ,  0xFF
 992              	.set FTFA_FlashConfig_BACKKEY7_KEY_SHIFT  ,  0
 993              	// ---------------------------------------------------------------
 994              	// NV FCF Backdoor Comparison Key 6
 995              	.set FTFA_FlashConfig_BACKKEY6_KEY_MASK   ,  0xFF
 996              	.set FTFA_FlashConfig_BACKKEY6_KEY_SHIFT  ,  0
 997              	// ---------------------------------------------------------------
 998              	// NV FCF Backdoor Comparison Key 5
 999              	.set FTFA_FlashConfig_BACKKEY5_KEY_MASK   ,  0xFF
 1000              	.set FTFA_FlashConfig_BACKKEY5_KEY_SHIFT  ,  0
 1001              	// ---------------------------------------------------------------
 1002              	// NV FCF Backdoor Comparison Key 4
 1003              	.set FTFA_FlashConfig_BACKKEY4_KEY_MASK   ,  0xFF
 1004              	.set FTFA_FlashConfig_BACKKEY4_KEY_SHIFT  ,  0
 1005              	// ---------------------------------------------------------------
 1006              	// NV FCF Flash Program Protection Byte 3
 1007              	.set FTFA_FlashConfig_FPROT3_PROT_MASK   ,  0xFF
 1008              	.set FTFA_FlashConfig_FPROT3_PROT_SHIFT  ,  0
 1009              	// ---------------------------------------------------------------
 1010              	// NV FCF Flash Program Protection Byte 2
 1011              	.set FTFA_FlashConfig_FPROT2_PROT_MASK   ,  0xFF
 1012              	.set FTFA_FlashConfig_FPROT2_PROT_SHIFT  ,  0
 1013              	// ---------------------------------------------------------------
 1014              	// NV FCF Flash Program Protection Byte 1
 1015              	.set FTFA_FlashConfig_FPROT1_PROT_MASK   ,  0xFF
 1016              	.set FTFA_FlashConfig_FPROT1_PROT_SHIFT  ,  0
 1017              	// ---------------------------------------------------------------
 1018              	// NV FCF Flash Program Protection Byte 0
 1019              	.set FTFA_FlashConfig_FPROT0_PROT_MASK   ,  0xFF
 1020              	.set FTFA_FlashConfig_FPROT0_PROT_SHIFT  ,  0
 1021              	// ---------------------------------------------------------------
 1022              	// NV FCF Flash Security Register
 1023              	// 7-6:KEYEN=backdoor key security enable
 1024              	//          :00,01(preferred),11=backdoor key access disabled
 1025              	//          :10=backdoor key access enabled
 1026              	// 5-4:MEEN=mass erase enable bits
 1027              	//         :00,01,11=mass erase enabled
 1028              	//         :10=mass erase disabled
 1029              	// 3-2:FSLACC=Freescale failure analysis access code
 1030              	//           :00,11=Freescale factory access granted
 1031              	//           :01,10=Freescale factory access denied
 1032              	// 1-0:SEC=flash security
 1033              	//        :00,01,11=secure
 1034              	//        :10=unsecure (standard shipping condition)
 1035              	.set FTFA_FlashConfig_FSEC_SEC_MASK      ,  0x3
 1036              	.set FTFA_FlashConfig_FSEC_SEC_SHIFT     ,  0
 1037              	.set FTFA_FlashConfig_FSEC_FSLACC_MASK   ,  0xC
 1038              	.set FTFA_FlashConfig_FSEC_FSLACC_SHIFT  ,  2
 1039              	.set FTFA_FlashConfig_FSEC_MEEN_MASK     ,  0x30
 1040              	.set FTFA_FlashConfig_FSEC_MEEN_SHIFT    ,  4
 1041              	.set FTFA_FlashConfig_FSEC_KEYEN_MASK    ,  0xC0
 1042              	.set FTFA_FlashConfig_FSEC_KEYEN_SHIFT   ,  6
 1043              	// ---------------------------------------------------------------
 1044              	// NV FCF Flash Option Register
 1045              	.set FTFA_FlashConfig_FOPT_LPBOOT0_MASK         ,  0x1
 1046              	.set FTFA_FlashConfig_FOPT_LPBOOT0_SHIFT        ,  0
 1047              	.set FTFA_FlashConfig_FOPT_NMI_DIS_MASK         ,  0x4
 1048              	.set FTFA_FlashConfig_FOPT_NMI_DIS_SHIFT        ,  2
 1049              	.set FTFA_FlashConfig_FOPT_RESET_PIN_CFG_MASK   ,  0x8
 1050              	.set FTFA_FlashConfig_FOPT_RESET_PIN_CFG_SHIFT  ,  3
 1051              	.set FTFA_FlashConfig_FOPT_LPBOOT1_MASK         ,  0x10
 1052              	.set FTFA_FlashConfig_FOPT_LPBOOT1_SHIFT        ,  4
 1053              	.set FTFA_FlashConfig_FOPT_FAST_INIT_MASK       ,  0x20
 1054              	.set FTFA_FlashConfig_FOPT_FAST_INIT_SHIFT      ,  5
 1055              	// ---------------------------------------------------------------
 1056              	// General-purpose input and output (GPIO)
 1057              	// GPIOx_PDD:  Port x Data Direction Register
 1058              	//   Bit n:  0=Port x pin n configured as input
 1059              	//           1=Port x pin n configured as output
 1060              	// GPIOx_PDIR:  Port x Data Input Register
 1061              	//   Bit n:  Value read from Port x pin n (if input pin)
 1062              	// GPIOx_PDOR:  Port x Data Output Register
 1063              	//   Bit n:  Value written to Port x pin n (if output pin)
 1064              	// GPIOx_PoOR: Port x operation o direction x Register
 1065              	//   Operation o:  C=Clear (clear to 0)
 1066              	//                 S=Set (set to 1)
 1067              	//                 T=Toggle (complement)
 1068              	//   Bit n:  0=Port x pin n not affected
 1069              	//           1=Port x pin n affected
 1070              	.set GPIO_BASE         ,  0x400FF000
 1071              	.set GPIO_PDOR_OFFSET  ,  0x00
 1072              	.set GPIO_PSOR_OFFSET  ,  0x04
 1073              	.set GPIO_PCOR_OFFSET  ,  0x08
 1074              	.set GPIO_PTOR_OFFSET  ,  0x0C
 1075              	.set GPIO_PDIR_OFFSET  ,  0x10
 1076              	.set GPIO_PDDR_OFFSET  ,  0x14
 1077              	// GPIOx not present in MKL05Z4.h:  PTx instead
 1078              	// GPIOx included for compatibility with MKL46Z4.h
 1079              	.set GPIOA_OFFSET      ,  0x00
 1080              	.set GPIOB_OFFSET      ,  0x40
 1081              	// Port A
 1082              	.set GPIOA_BASE        ,  0x400FF000
 1083              	.set GPIOA_PDOR        ,  (GPIOA_BASE + GPIO_PDOR_OFFSET)
 1084              	.set GPIOA_PSOR        ,  (GPIOA_BASE + GPIO_PSOR_OFFSET)
 1085              	.set GPIOA_PCOR        ,  (GPIOA_BASE + GPIO_PCOR_OFFSET)
 1086              	.set GPIOA_PTOR        ,  (GPIOA_BASE + GPIO_PTOR_OFFSET)
 1087              	.set GPIOA_PDIR        ,  (GPIOA_BASE + GPIO_PDIR_OFFSET)
 1088              	.set GPIOA_PDDR        ,  (GPIOA_BASE + GPIO_PDDR_OFFSET)
 1089              	// Port B
 1090              	.set GPIOB_BASE        ,  0x400FF040
 1091              	.set GPIOB_PDOR        ,  (GPIOB_BASE + GPIO_PDOR_OFFSET)
 1092              	.set GPIOB_PSOR        ,  (GPIOB_BASE + GPIO_PSOR_OFFSET)
 1093              	.set GPIOB_PCOR        ,  (GPIOB_BASE + GPIO_PCOR_OFFSET)
 1094              	.set GPIOB_PTOR        ,  (GPIOB_BASE + GPIO_PTOR_OFFSET)
 1095              	.set GPIOB_PDIR        ,  (GPIOB_BASE + GPIO_PDIR_OFFSET)
 1096              	.set GPIOB_PDDR        ,  (GPIOB_BASE + GPIO_PDDR_OFFSET)
 1097              	// ---------------------------------------------------------------
 1098              	// IOPORT:  GPIO alias for zero wait state access to GPIO
 1099              	// See FGPIO
 1100              	// ---------------------------------------------------------------
 1101              	// Multipurpose clock generator (MCG)
 1102              	.set MCG_BASE          ,  0x40064000
 1103              	.set MCG_C1_OFFSET     ,  0x00
 1104              	.set MCG_C2_OFFSET     ,  0x01
 1105              	.set MCG_C3_OFFSET     ,  0x02
 1106              	.set MCG_C4_OFFSET     ,  0x03
 1107              	.set MCG_C6_OFFSET     ,  0x05
 1108              	.set MCG_S_OFFSET      ,  0x06
 1109              	.set MCG_SC_OFFSET     ,  0x08
 1110              	.set MCG_ATCVH_OFFSET  ,  0x0A
 1111              	.set MCG_ATCVL_OFFSET  ,  0x0B
 1112              	.set MCG_C1            ,  (MCG_BASE + MCG_C1_OFFSET)
 1113              	.set MCG_C2            ,  (MCG_BASE + MCG_C2_OFFSET)
 1114              	.set MCG_C3            ,  (MCG_BASE + MCG_C3_OFFSET)
 1115              	.set MCG_C4            ,  (MCG_BASE + MCG_C4_OFFSET)
 1116              	.set MCG_C6            ,  (MCG_BASE + MCG_C6_OFFSET)
 1117              	.set MCG_S             ,  (MCG_BASE + MCG_S_OFFSET)
 1118              	.set MCG_SC            ,  (MCG_BASE + MCG_SC_OFFSET)
 1119              	.set MCG_ATCVH         ,  (MCG_BASE + MCG_ATCVH_OFFSET)
 1120              	.set MCG_ATCVL         ,  (MCG_BASE + MCG_ATCVL_OFFSET)
 1121              	// ---------------------------------------------------------------
 1122              	// MCG_C1 MCG Control 1 Register(0x04)
 1123              	// 7-6:CLKS=clock source select (00)
 1124              	//         :00=output of FLL
 1125              	//         :01=internal reference clock
 1126              	//         :10=external reference clock
 1127              	//         :11=(reserved)
 1128              	// 5-3:FRDIV=FLL external reference divider (000)
 1129              	//     (depends on MCG_C2.RANGE0)
 1130              	//          :first divider is for RANGE0=0
 1131              	//          :second divider is for all other RANGE0 values
 1132              	//          :000=  1 or   32
 1133              	//          :001=  2 or   64
 1134              	//          :010=  4 or  128
 1135              	//          :011=  8 or  256
 1136              	//          :100= 16 or  512
 1137              	//          :101= 32 or 1024
 1138              	//          :110= 64 or 1280
 1139              	//          :111=128 or 1536
 1140              	//   2:IREFS=internal reference select (for FLL) (1)
 1141              	//          :0=external reference clock
 1142              	//          :1=slow internal reference clock
 1143              	//   1:IRCLKEN=internal reference clock (MCGIRCLK) enable (0)
 1144              	//   0:IREFSTEN=internal reference stop enable (0)
 1145              	.set MCG_C1_CLKS_MASK       , 0xC0
 1146              	.set MCG_C1_CLKS_SHIFT      , 6
 1147              	.set MCG_C1_FRDIV_MASK      , 0x38
 1148              	.set MCG_C1_FRDIV_SHIFT     , 3
 1149              	.set MCG_C1_IREFS_MASK      , 0x04
 1150              	.set MCG_C1_IREFS_SHIFT     , 2
 1151              	.set MCG_C1_IRCLKEN_MASK    , 0x02
 1152              	.set MCG_C1_IRCLKEN_SHIFT   , 1
 1153              	.set MCG_C1_IREFSTEN_MASK   , 0x01
 1154              	.set MCG_C1_IREFSTEN_SHIFT  , 0
 1155              	// ---------------------------------------------------------------
 1156              	// MCG_C2 MCG Control 2 Register(0xC0)
 1157              	//   7:LOCRE0=loss of clock reset enable (1)
 1158              	//           :0=interrupt request on loss of OCS0 external reference clock
 1159              	//           :1=reset request on loss of OCS0 external reference clock
 1160              	//   6:(reserved):read-only:0
 1161              	// 5-4:RANGE0=frequency range select (00)
 1162              	//           :00=low frequency range for crystal oscillator
 1163              	//           :01=high frequency range for crystal oscillator
 1164              	//           :1X=very high frequency range for crystal oscillator
 1165              	//   3:HGO0=high gain oscillator select (0)
 1166              	//         :0=low-power operation
 1167              	//         :1=high-gain operation
 1168              	//   2:EREFS0=external reference select (0)
 1169              	//           :0=external reference clock
 1170              	//           :1=oscillator
 1171              	//   1:LP=low power select (0)
 1172              	//       :0=FLL or PLL not disabled in bypass modes
 1173              	//       :1=FLL or PLL disabled in bypass modes (lower power)
 1174              	//   0:IRCS=internal reference clock select (0)
 1175              	//         :0=slow internal reference clock
 1176              	//         :1=fast internal reference clock
 1177              	.set MCG_C2_LOCRE0_MASK        ,  0x80
 1178              	.set MCG_C2_LOCRE0_SHIFT       ,  7
 1179              	.set MCG_C2_RANGE0_MASK        ,  0x30
 1180              	.set MCG_C2_RANGE0_SHIFT       ,  4
 1181              	.set MCG_C2_HGO0_MASK          ,  0x08
 1182              	.set MCG_C2_HGO0_SHIFT         ,  3
 1183              	.set MCG_C2_EREFS0_MASK        ,  0x04
 1184              	.set MCG_C2_EREFS0_SHIFT       ,  2
 1185              	.set MCG_C2_LP_MASK            ,  0x02
 1186              	.set MCG_C2_LP_SHIFT           ,  1
 1187              	.set MCG_C2_IRCS_MASK          ,  0x01
 1188              	.set MCG_C2_IRCS_SHIFT         ,  0
 1189              	// ---------------------------------------------------------------
 1190              	// MCG_C3 MCG Control 3 Register (0xXX)
 1191              	// 7-0:SCTRIM=slow internal reference clock trim setting;
 1192              	//            on reset, loaded with a factory trim value
 1193              	.set MCG_C3_SCTRIM_MASK   ,  0xFF
 1194              	.set MCG_C3_SCTRIM_SHIFT  ,  0
 1195              	// ---------------------------------------------------------------
 1196              	// MCG_C4 MCG Control 4 Register (2_000XXXXX)
 1197              	//   7:DMX32=DCO maximum frequency with 32.768 kHz reference (0)
 1198              	//          :0=default range of 25%
 1199              	//          :1=fine-tuned for 32.768 kHz reference
 1200              	// 6-5:DRST_DRS=DCO range select (00)
 1201              	//             :00=low range (default)
 1202              	//             :01=mid range
 1203              	//             :10=mid-high range
 1204              	//             :11=high range
 1205              	// 4-1:FCTRIM=fast internal reference clock trim setting (XXXX)
 1206              	//            on reset, loaded with a factory trim value
 1207              	//   0:SCFTRIM=slow internal reference clock fine trim (X)
 1208              	//            on reset, loaded with a factory trim value
 1209              	.set MCG_C4_DMX32_MASK      ,  0x80
 1210              	.set MCG_C4_DMX32_SHIFT     ,  7
 1211              	.set MCG_C4_DRST_DRS_MASK   ,  0x60
 1212              	.set MCG_C4_DRST_DRS_SHIFT  ,  5
 1213              	.set MCG_C4_FCTRIM_MASK     ,  0x1E
 1214              	.set MCG_C4_FCTRIM_SHIFT    ,  1
 1215              	.set MCG_C4_SCFTRIM_MASK    ,  0x1
 1216              	.set MCG_C4_SCFTRIM_SHIFT   ,  0
 1217              	// ---------------------------------------------------------------
 1218              	// MCG_C6 MCG Control 6 Register (0x00)
 1219              	// 7-6:(reserved):read-only:00
 1220              	//   5:CME=clock monitor enable (0)
 1221              	// 4-0:(reserved):read-only:00000
 1222              	.set MCG_C6_CME_MASK      ,  0x20
 1223              	.set MCG_C6_CME_SHIFT     ,  5
 1224              	// ---------------------------------------------------------------
 1225              	// MCG_S MCG Status Register (0x10)
 1226              	// 7-5:(reserved):read-only:000
 1227              	//   4:IREFST=internal reference status (1)
 1228              	//           :0=FLL source external
 1229              	//           :1=FLL source internal
 1230              	// 3-2:CLKST=clock mode status (00)
 1231              	//          :00=FLL
 1232              	//          :01=internal reference
 1233              	//          :10=external reference
 1234              	//          :11=(reserved)
 1235              	//   1:OSCINIT0=OSC initialization (complete)
 1236              	//   0:IRCST=internal reference clock status
 1237              	//          :0=slow (32 kHz)
 1238              	//          :1=fast (4 MHz)
 1239              	.set MCG_S_IREFST_MASK      ,  0x10
 1240              	.set MCG_S_IREFST_SHIFT     ,  4
 1241              	.set MCG_S_CLKST_MASK       ,  0x0C
 1242              	.set MCG_S_CLKST_SHIFT      ,  2
 1243              	.set MCG_S_OSCINIT0_MASK    ,  0x02
 1244              	.set MCG_S_OSCINIT0_SHIFT   ,  1
 1245              	.set MCG_S_IRCST_MASK       ,  0x01
 1246              	.set MCG_S_IRCST_SHIFT      ,  0
 1247              	// ---------------------------------------------------------------
 1248              	// MCG_SC:  MCG Status and Control Register (0x02)
 1249              	//   7:ATME=automatic trim machine enable (0)
 1250              	//   6:ATMS=automatic trim machine select (0)
 1251              	//         :0=32-kHz internal reference clock
 1252              	//         :1=4-MHz internal reference clock
 1253              	//   5:ATMF=automatic trim machine fail flag (read only) (0)
 1254              	//   4:FLTPRSRV=FLL filter preserve enable (0)
 1255              	// 3-1:FCRDIV=fast clock internal reference divider (001)
 1256              	//           :000=  1
 1257              	//           :001=  2
 1258              	//           :010=  4
 1259              	//           :011=  8
 1260              	//           :100= 16
 1261              	//           :101= 32
 1262              	//           :110= 64
 1263              	//           :111=128
 1264              	//   0:LOCS0=OSC0 loss of clock status (0)
 1265              	.set MCG_SC_ATME_MASK       ,  0x80
 1266              	.set MCG_SC_ATME_SHIFT      ,  7
 1267              	.set MCG_SC_ATMS_MASK       ,  0x40
 1268              	.set MCG_SC_ATMS_SHIFT      ,  6
 1269              	.set MCG_SC_ATMF_MASK       ,  0x20
 1270              	.set MCG_SC_ATMF_SHIFT      ,  5
 1271              	.set MCG_SC_FLTPRSRV_MASK   ,  0x10
 1272              	.set MCG_SC_FLTPRSRV_SHIFT  ,  4
 1273              	.set MCG_SC_FCRDIV_MASK     ,  0xE
 1274              	.set MCG_SC_FCRDIV_SHIFT    ,  1
 1275              	.set MCG_SC_LOCS0_MASK      ,  0x01
 1276              	.set MCG_SC_LOCS0_SHIFT     ,  0
 1277              	// ---------------------------------------------------------------
 1278              	// MCG_ATCVH:  MCG Auto Trim Compare Value High Register (0x00)
 1279              	// 7-0:ATCVH=Auto trim machine compare value high (0x00)
 1280              	.set MCG_ATCVH_ATCVH_MASK   ,  0xFF
 1281              	.set MCG_ATCVH_ATCVH_SHIFT  ,  0
 1282              	// ---------------------------------------------------------------
 1283              	// MCG_ATCVL:  MCG Auto Trim Compare Value Low Register (0x00)
 1284              	// 7-0:ATCVL=Auto trim machine compare value low (0x00)
 1285              	.set MCG_ATCVL_ATCVL_MASK   ,  0xFF
 1286              	.set MCG_ATCVL_ATCVL_SHIFT  ,  0
 1287              	// ---------------------------------------------------------------
 1288              	// Nonvolatile (flash configuration field)
 1289              	// NV Peripheral access layer
 1290              	// Following [3]
 1291              	.set NV_BASE             ,  0x400
 1292              	.set NV_BACKKEY3_OFFSET  ,  0x0
 1293              	.set NV_BACKKEY2_OFFSET  ,  0x1
 1294              	.set NV_BACKKEY1_OFFSET  ,  0x2
 1295              	.set NV_BACKKEY0_OFFSET  ,  0x3
 1296              	.set NV_BACKKEY7_OFFSET  ,  0x4
 1297              	.set NV_BACKKEY6_OFFSET  ,  0x5
 1298              	.set NV_BACKKEY5_OFFSET  ,  0x6
 1299              	.set NV_BACKKEY4_OFFSET  ,  0x7
 1300              	.set NV_FPROT3_OFFSET    ,  0x8
