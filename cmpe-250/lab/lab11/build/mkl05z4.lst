 1841              	// ---------------------------------------------------------------
 1842              	// PORTx_PCRn (Port x pin control register n [for pin n])
 1843              	// 31-25:(reserved):read-only:0
 1844              	//    24:ISF=interrupt status flag; write 1 clears
 1845              	// 23-20:(reserved):read-only:0
 1846              	// 19-16:IRCQ=interrupt configuration
 1847              	//           :0000=interrupt/DMA request disabled
 1848              	//           :0001=DMA request on rising edge
 1849              	//           :0010=DMA request on falling edge
 1850              	//           :0011=DMA request on either edge
 1851              	//           :1000=interrupt when logic zero
 1852              	//           :1001=interrupt on rising edge
 1853              	//           :1010=interrupt on falling edge
 1854              	//           :1011=interrupt on either edge
 1855              	//           :1100=interrupt when logic one
 1856              	//           :others=reserved
 1857              	// 15-11:(reserved):read-only:0
 1858              	// 10-08:MUX=Pin mux control
 1859              	//          :000=pin disabled (analog)
 1860              	//          :001=alternative 1 (GPIO)
 1861              	//          :010-111=alternatives 2-7 (chip-specific)
 1862              	//     7:(reserved):read-only:0
 1863              	//     6:DSE=Drive strength enable
 1864              	//          :0=low
 1865              	//          :1=high
 1866              	//     5:(reserved):read-only:0
 1867              	//     4:PFE=Passive filter enable
 1868              	//     3:(reserved):read-only:0
 1869              	//     2:SRE=Slew rate enable
 1870              	//          :0=fast
 1871              	//          :1=slow
 1872              	//     1:PE=Pull enable
 1873              	//     0:PS=Pull select (if PE=1)
 1874              	//         :0=internal pulldown
 1875              	//         :1=internal pullup
 1876              	.set PORT_PCR_ISF_MASK           ,  0x1000000
 1877              	.set PORT_PCR_ISF_SHIFT          ,  24
 1878              	.set PORT_PCR_IRCQ_MASK          ,  0xF0000
 1879              	.set PORT_PCR_IRCQ_SHIFT         ,  16
 1880              	.set PORT_PCR_MUX_MASK           ,  0x700
 1881              	.set PORT_PCR_MUX_SHIFT          ,  8
 1882              	.set PORT_PCR_DSE_MASK           ,  0x40
 1883              	.set PORT_PCR_DSE_SHIFT          ,  6
 1884              	.set PORT_PCR_PFE_MASK           ,  0x10
 1885              	.set PORT_PCR_PFE_SHIFT          ,  4
 1886              	.set PORT_PCR_SRE_MASK           ,  0x04
 1887              	.set PORT_PCR_SRE_SHIFT          ,  2
 1888              	.set PORT_PCR_PE_MASK            ,  0x02
 1889              	.set PORT_PCR_PE_SHIFT           ,  1
 1890              	.set PORT_PCR_PS_MASK            ,  0x01
 1891              	.set PORT_PCR_PS_SHIFT           ,  0
 1892              	.set PORT_PCR_MUX_SELECT_0_MASK  ,  0x00000000 // analog
 1893              	.set PORT_PCR_MUX_SELECT_1_MASK  ,  0x00000100 // GPIO
 1894              	.set PORT_PCR_MUX_SELECT_2_MASK  ,  0x00000200
 1895              	.set PORT_PCR_MUX_SELECT_3_MASK  ,  0x00000300
 1896              	.set PORT_PCR_MUX_SELECT_4_MASK  ,  0x00000400
 1897              	.set PORT_PCR_MUX_SELECT_5_MASK  ,  0x00000500
 1898              	.set PORT_PCR_MUX_SELECT_6_MASK  ,  0x00000600
 1899              	.set PORT_PCR_MUX_SELECT_7_MASK  ,  0x00000700
 1900              	// ---------------------------------------------------------------
 1901              	// PORTx_GPCLR (Port x global pin control low register) 
 1902              	// (32-bit write only)
 1903              	// 31-16:GPWE=global pin write enable; write only (0x0000)
 1904              	//       bit n:  0=PORTx_PCR<n-16> not updated from GPWD
 1905              	//               1=PORTx_PCR<n-16> is updated from GPWD
 1906              	//  15-0:GPWD=global pin write data; write only (0x0000)
 1907              	//       Value written to PORTx_PCR[15:0] selected by GPWE
 1908              	.set PORT_GPCLR_GPWE_MASK   ,  0xFFFF0000
 1909              	.set PORT_GPCLR_GPWE_SHIFT  ,  16
 1910              	.set PORT_GPCLR_GPWD_MASK   ,  0xFFFF
 1911              	.set PORT_GPCLR_GPWD_SHIFT  ,  0
 1912              	// ---------------------------------------------------------------
 1913              	// PORTx_GPCHR (Port x global pin control high register)
 1914              	// (32-bit write only)
 1915              	// 31-16:GPWE=global pin write enable; write only (0x0000)
 1916              	//       bit n:  0=PORTx_PCRn not updated from GPWD
 1917              	//               1=PORTx_PCRn is updated from GPWD
 1918              	//  15-0:GPWD=global pin write data; write only (0x0000)
 1919              	//       Value written to PORTx_PCR[15:0] selected by GPWE
 1920              	.set PORT_GPCHR_GPWE_MASK   ,  0xFFFF0000
 1921              	.set PORT_GPCHR_GPWE_SHIFT  ,  16
 1922              	.set PORT_GPCHR_GPWD_MASK   ,  0xFFFF
 1923              	.set PORT_GPCHR_GPWD_SHIFT  ,  0
 1924              	// ---------------------------------------------------------------
 1925              	// PORTx_ISFR (Port x interrupt status flag register)
 1926              	// (bit n read-only if PORTX pin n does not support interrupts)
 1927              	// (bit n write 1 clears bit n)
 1928              	// bit n:  0:  PORTx pin n configured interrupt not detected
 1929              	//         1:  PORTx pin n configured interrupt detected
 1930              	//             * If used to generate DMA request,
 1931              	//               automatically cleared on DMA transfer completion
 1932              	//             * Otherwise, remains 1 until 1 written
 1933              	//       bit nn:  0=PORTx_PCRnn not updated from GPWD
 1934              	//                1=PORTx_PCRnn is updated from GPWD
 1935              	//  15-0:GPWD=global pin write data; write only (0x0000)
 1936              	//       Value written to PORTx_PCR[15:0] selected by GPWE
 1937              	.set PORT_ISFR_ISF_MASK   ,  0xFFFFFFFF
 1938              	.set PORT_ISFR_ISF_SHIFT  ,  0
 1939              	// ---------------------------------------------------------------
 1940              	// PTx not present in MKL46Z4.h
 1941              	// General-purpose input and output (PTx)
 1942              	// PTx_PDD:  Port x Data Direction Register
 1943              	//   Bit n:  0=Port x pin n configured as input
 1944              	//           1=Port x pin n configured as output
 1945              	// PTx_PDIR:  Port x Data Input Register
 1946              	//   Bit n:  Value read from Port x pin n (if input pin)
 1947              	// PTx_PDOR:  Port x Data Output Register
 1948              	//   Bit n:  Value written to Port x pin n (if output pin)
 1949              	// PTx_PoOR: Port x operation o direction x Register
 1950              	//   Operation o:  C=Clear (clear to 0)
 1951              	//                 S=Set (set to 1)
 1952              	//                 T=Toggle (complement)
 1953              	//   Bit n:  0=Port x pin n not affected
 1954              	//           1=Port x pin n affected
 1955              	.set PT_BASE         ,  0x400FF000
 1956              	.set PT_PDOR_OFFSET  ,  0x00
 1957              	.set PT_PSOR_OFFSET  ,  0x04
 1958              	.set PT_PCOR_OFFSET  ,  0x08
 1959              	.set PT_PTOR_OFFSET  ,  0x0C
 1960              	.set PT_PDIR_OFFSET  ,  0x10
 1961              	.set PT_PDDR_OFFSET  ,  0x14
 1962              	.set PTA_OFFSET      ,  0x00
 1963              	.set PTB_OFFSET      ,  0x40
 1964              	// Port A (PTA)
 1965              	.set PTA_BASE        ,  0x400FF000
 1966              	.set PTA_PDOR        ,  (PTA_BASE + PT_PDOR_OFFSET)
 1967              	.set PTA_PSOR        ,  (PTA_BASE + PT_PSOR_OFFSET)
 1968              	.set PTA_PCOR        ,  (PTA_BASE + PT_PCOR_OFFSET)
 1969              	.set PTA_PTOR        ,  (PTA_BASE + PT_PTOR_OFFSET)
 1970              	.set PTA_PDIR        ,  (PTA_BASE + PT_PDIR_OFFSET)
 1971              	.set PTA_PDDR        ,  (PTA_BASE + PT_PDDR_OFFSET)
 1972              	// Port B (PTB)
 1973              	.set PTB_BASE         ,  0x400FF040
 1974              	.set PTB_PDOR         ,  (PTB_BASE + PT_PDOR_OFFSET)
 1975              	.set PTB_PSOR         ,  (PTB_BASE + PT_PSOR_OFFSET)
 1976              	.set PTB_PCOR         ,  (PTB_BASE + PT_PCOR_OFFSET)
 1977              	.set PTB_PTOR         ,  (PTB_BASE + PT_PTOR_OFFSET)
 1978              	.set PTB_PDIR         ,  (PTB_BASE + PT_PDIR_OFFSET)
 1979              	.set PTB_PDDR         ,  (PTB_BASE + PT_PDDR_OFFSET)
 1980              	// ---------------------------------------------------------------
 1981              	// IOPORT:  GPIO alias for zero wait state access to GPIO
 1982              	// See FGPIO
