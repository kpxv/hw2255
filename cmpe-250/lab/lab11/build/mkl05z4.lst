 1588              	.set OSC0_CR_OFFSET  ,  0
 1589              	.set OSC0_CR         ,  (OSC0_BASE + OSC0_CR_OFFSET)
 1590              	// ---------------------------------------------------------------
 1591              	// OSC0_CR (0x00)
 1592              	// 7:ERCLKEN=external reference enable, OSCERCLK (0)
 1593              	// 6:(reserved):read-only:0
 1594              	// 5:EREFSTEN=external reference stop enable (0)
 1595              	// 4:(reserved):read-only:0
 1596              	// 3:SC2P=oscillator 2-pF capacitor load configure (0)
 1597              	// 2:SC4P=oscillator 4-pF capacitor load configure (0)
 1598              	// 1:SC8P=oscillator 8-pF capacitor load configure (0)
 1599              	// 0:SC16P=oscillator 16-pF capacitor load configure (0)
 1600              	.set OSC_CR_SC16P_MASK      ,  0x1
