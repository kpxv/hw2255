 2024              	// ---------------------------------------------------------------
 2025              	// SIM_CLKDIV1
 2026              	// 31-28:OUTDIV1=clock 1 output divider value
 2027              	//              :set divider for core/system clock,
 2028              	//              :from which bus/flash clocks are derived
 2029              	//              :divide by OUTDIV1 + 1
 2030              	// 27-19:Reserved; read-only; always 0
 2031              	// 18-16:OUTDIV4=clock 4 output divider value
 2032              	//              :sets divider for bus and flash clocks,
 2033              	//              :relative to core/system clock
 2034              	//              :divide by OUTDIV4 + 1
 2035              	// 15-00:Reserved; read-only; always 0
 2036              	.set SIM_CLKDIV1_OUTDIV1_MASK       , 0xF0000000
 2037              	.set SIM_CLKDIV1_OUTDIV1_SHIFT      , 28
 2038              	.set SIM_CLKDIV1_OUTDIV4_MASK       , 0x00070000
 2039              	.set SIM_CLKDIV1_OUTDIV4_SHIFT      , 16
 2040              	// ---------------------------------------------------------------
 2041              	// SIM_COPC
 2042              	// 31-04:Reserved; read-only; always 0
 2043              	// 03-02:COPT=COP watchdog timeout
 2044              	//           :00=disabled
 2045              	//           :01=timeout after 2^5 LPO cycles or 2^13 bus cycles
 2046              	//           :10=timeout after 2^8 LPO cycles or 2^16 bus cycles
 2047              	//           :11=timeout after 2^10 LPO cycles or 2^18 bus cycles
 2048              	//    01:COPCLKS=COP clock select
 2049              	//              :0=internal 1 kHz
 2050              	//              :1=bus clock
 2051              	//    00:COPW=COP windowed mode
 2052              	.set COP_COPT_MASK      ,  0x0000000C
 2053              	.set COP_COPT_SHIFT     ,  2
 2054              	.set COP_COPCLKS_MASK   ,  0x00000002
 2055              	.set COP_COPCLKS_SHIFT  ,  1
 2056              	.set COP_COPW_MASK      ,  0x00000001
 2057              	.set COP_COPW_SHIFT     ,  1
 2058              	// ---------------------------------------------------------------
 2059              	// SIM_SCGC4
 2060              	// 1->31-28:Reserved; read-only; always 1
 2061              	// 0->27-24:Reserved; read-only; always 0
 2062              	// 0->   23:SPI1=SPI1 clock gate control (disabled)
 2063              	// 0->   22:SPI0=SPI0 clock gate control (disabled)
 2064              	// 0->21-20:Reserved; read-only; always 0
 2065              	// 0->   19:CMP=comparator clock gate control (disabled)
 2066              	// 0->   18:USBOTG=USB clock gate control (disabled)
 2067              	// 0->17-14:Reserved; read-only; always 0
 2068              	// 0->   13:Reserved; read-only; always 0
 2069              	// 0->   12:UART2=UART2 clock gate control (disabled)
 2070              	// 1->   11:UART1=UART1 clock gate control (disabled)
 2071              	// 0->   10:UART0=UART0 clock gate control (disabled)
 2072              	// 0->09-08:Reserved; read-only; always 0
 2073              	// 0->   07:I2C1=I2C1 clock gate control (disabled)
 2074              	// 0->   06:I2C0=I2C0 clock gate control (disabled)
 2075              	// 1->05-04:Reserved; read-only; always 1
 2076              	// 0->03-00:Reserved; read-only; always 0
 2077              	.set SIM_SCGC4_SPI0_MASK     ,  0x00400000
 2078              	.set SIM_SCGC4_SPI0_SHIFT    ,  22
 2079              	.set SIM_SCGC4_CMP_MASK      ,  0x00080000
 2080              	.set SIM_SCGC4_CMP_SHIFT     ,  19
 2081              	.set SIM_SCGC4_UART0_MASK    ,  0x00000400
 2082              	.set SIM_SCGC4_UART0_SHIFT   ,  10
 2083              	.set SIM_SCGC4_I2C0_MASK     ,  0x00000040
 2084              	.set SIM_SCGC4_I2C0_SHIFT    ,  6
 2085              	// ---------------------------------------------------------------
 2086              	// SIM_SCGC5
 2087              	// 31-20:Reserved; read-only; always 0
 2088              	//    19:SLCD=segment LCD clock gate control
 2089              	// 18-14:Reserved; read-only; always 0
 2090              	//    13:PORTE=Port E clock gate control
 2091              	//    12:PORTD=Port D clock gate control
 2092              	//    11:PORTC=Port C clock gate control
 2093              	//    10:PORTB=Port B clock gate control
 2094              	//     9:PORTA=Port A clock gate control
 2095              	// 08-07:Reserved; read-only; always 1
 2096              	//     6:Reserved; read-only; always 0
 2097              	//     5:TSI=TSI access control
 2098              	// 04-02:Reserved; read-only; always 0
 2099              	//     1:Reserved; read-only; always 0
 2100              	//     0:LPTMR=Low power timer access control
 2101              	.set SIM_SCGC5_PORTB_MASK   ,  0x00000400
 2102              	.set SIM_SCGC5_PORTB_SHIFT  ,  10
 2103              	.set SIM_SCGC5_PORTA_MASK   ,  0x00000200
 2104              	.set SIM_SCGC5_PORTA_SHIFT  ,  9
 2105              	.set SIM_SCGC5_TSI_MASK     ,  0x00000020
 2106              	.set SIM_SCGC5_TSI_SHIFT    ,  5
 2107              	.set SIM_SCGC5_LPTMR_MASK   ,  0x00000001
 2108              	.set SIM_SCGC5_LPTMR_SHIFT  ,  0
 2109              	// ---------------------------------------------------------------
 2110              	// SIM_SCGC6
 2111              	//    31:DAC0=DAC0 clock gate control
 2112              	//    30:(reserved):read-only:0
 2113              	//    29:RTC=RTC access control
 2114              	//    28:(reserved):read-only:0
 2115              	//    27:ADC0=ADC0 clock gate control
 2116              	//    26:TPM2=TPM2 clock gate control
 2117              	//    25:TPM1=TMP1 clock gate control
 2118              	//    24:TPM0=TMP0 clock gate control
 2119              	//    23:PIT=PIT clock gate control
 2120              	// 22-16:(reserved)
 2121              	//    15:(reserved)
 2122              	// 14-02:(reserved)
 2123              	//     1:DMAMUX=DMA mux clock gate control
 2124              	//     0:FTF=flash memory clock gate control
 2125              	.set SIM_SCGC6_DAC0_MASK     ,  0x80000000
 2126              	.set SIM_SCGC6_DAC0_SHIFT    ,  31
