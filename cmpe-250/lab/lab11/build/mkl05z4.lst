 1367              	.set NV_FPROT0_PROT_SHIFT  ,  0
 1368              	// ---------------------------------------------------------------
 1369              	// NV FCF Flash Security Register
 1370              	// 7-6:KEYEN=backdoor key security enable
 1371              	//          :00,01(preferred),11=backdoor key access disabled
 1372              	//          :10=backdoor key access enabled
 1373              	// 5-4:MEEN=mass erase enable bits
 1374              	//         :00,01,11=mass erase enabled
 1375              	//         :10=mass erase disabled
 1376              	// 3-2:FSLACC=Freescale failure analysis access code
 1377              	//           :00,11=Freescale factory access granted
 1378              	//           :01,10=Freescale factory access denied
 1379              	// 1-0:SEC=flash security
 1380              	//        :00,01,11=secure
 1381              	//        :10=unsecure (standard shipping condition)
 1382              	.set NV_FSEC_SEC_MASK      ,  0x3
 1383              	.set NV_FSEC_SEC_SHIFT     ,  0
 1384              	.set NV_FSEC_FSLACC_MASK   ,  0xC
 1385              	.set NV_FSEC_FSLACC_SHIFT  ,  2
 1386              	.set NV_FSEC_MEEN_MASK     ,  0x30
 1387              	.set NV_FSEC_MEEN_SHIFT    ,  4
 1388              	.set NV_FSEC_KEYEN_MASK    ,  0xC0
 1389              	.set NV_FSEC_KEYEN_SHIFT   ,  6
 1390              	// ---------------------------------------------------------------
 1391              	// NV FCF Flash Option Register
 1392              	.set NV_FOPT_LPBOOT0_MASK         ,  0x1
 1393              	.set NV_FOPT_LPBOOT0_SHIFT        ,  0
 1394              	.set NV_FOPT_NMI_DIS_MASK         ,  0x4
 1395              	.set NV_FOPT_NMI_DIS_SHIFT        ,  2
 1396              	.set NV_FOPT_RESET_PIN_CFG_MASK   ,  0x8
 1397              	.set NV_FOPT_RESET_PIN_CFG_SHIFT  ,  3
 1398              	.set NV_FOPT_LPBOOT1_MASK         ,  0x10
 1399              	.set NV_FOPT_LPBOOT1_SHIFT        ,  4
 1400              	.set NV_FOPT_FAST_INIT_MASK       ,  0x20
 1401              	.set NV_FOPT_FAST_INIT_SHIFT      ,  5
