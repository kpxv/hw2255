 2259              	.set TPM0_C3SC    , (TPM0_BASE + TPM_C3SC_OFFSET  )
 2260              	.set TPM0_C3V     , (TPM0_BASE + TPM_C3V_OFFSET   )
 2261              	.set TPM0_C4SC    , (TPM0_BASE + TPM_C4SC_OFFSET  )
 2262              	.set TPM0_C4V     , (TPM0_BASE + TPM_C4V_OFFSET   )
