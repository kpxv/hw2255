 2221              	.set SIM_SOPT5_UART0RXSRC_SHIFT  ,  2
 2222              	.set SIM_SOPT5_UART0TXSRC_MASK   ,  0x00000001
 2223              	.set SIM_SOPT5_UART0TXSRC_SHIFT  ,  0
