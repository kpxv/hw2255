 1302              	.set NV_FPROT1_OFFSET    ,  0xA
 1303              	.set NV_FPROT0_OFFSET    ,  0xB
 1304              	.set NV_FSEC_OFFSET      ,  0xC
 1305              	.set NV_FOPT_OFFSET      ,  0xD
 1306              	.set NV_BACKKEY3         ,  (NV_BASE + NV_BACKKEY3_OFFSET)
 1307              	.set NV_BACKKEY2         ,  (NV_BASE + NV_BACKKEY2_OFFSET)
 1308              	.set NV_BACKKEY1         ,  (NV_BASE + NV_BACKKEY1_OFFSET)
 1309              	.set NV_BACKKEY0         ,  (NV_BASE + NV_BACKKEY0_OFFSET)
 1310              	.set NV_BACKKEY7         ,  (NV_BASE + NV_BACKKEY7_OFFSET)
