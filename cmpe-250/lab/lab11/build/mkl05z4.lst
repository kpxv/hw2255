 2012              	.set SIM_SCGC7            ,  (SIM_BASE + SIM_SCGC7_OFFSET)
 2013              	.set SIM_SDID             ,  (SIM_BASE + SIM_SDID_OFFSET)
 2014              	.set SIM_SOPT1            ,  (SIM_BASE + SIM_SOPT1_OFFSET)
 2015              	.set SIM_SOPT1CFG         ,  (SIM_BASE + SIM_SOPT1CFG_OFFSET)
 2016              	.set SIM_SOPT2            ,  (SIM_BASE + SIM_SOPT2_OFFSET)
 2017              	.set SIM_SOPT4            ,  (SIM_BASE + SIM_SOPT4_OFFSET)
 2018              	.set SIM_SOPT5            ,  (SIM_BASE + SIM_SOPT5_OFFSET)
 2019              	.set SIM_SOPT7            ,  (SIM_BASE + SIM_SOPT7_OFFSET)
