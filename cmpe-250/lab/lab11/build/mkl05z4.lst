 2128              	.set SIM_SCGC6_RTC_SHIFT     ,  29
 2129              	.set SIM_SCGC6_ADC0_MASK     ,  0x08000000
 2130              	.set SIM_SCGC6_ADC0_SHIFT    ,  27
 2131              	.set SIM_SCGC6_TPM1_MASK     ,  0x02000000
 2132              	.set SIM_SCGC6_TPM1_SHIFT    ,  25
 2133              	.set SIM_SCGC6_TPM0_MASK     ,  0x01000000
 2134              	.set SIM_SCGC6_TPM0_SHIFT    ,  24
 2135              	.set SIM_SCGC6_PIT_MASK      ,  0x00800000
 2136              	.set SIM_SCGC6_PIT_SHIFT     ,  23
 2137              	.set SIM_SCGC6_DMAMUX_MASK   ,  0x00000002
 2138              	.set SIM_SCGC6_DMAMUX_SHIFT  ,  1
 2139              	.set SIM_SCGC6_FTF_MASK      ,  0x00000001
 2140              	.set SIM_SCGC6_FTF_SHIFT     ,  0
 2141              	// ---------------------------------------------------------------
 2142              	// SIM_SOPT1 (POR or LVD:  0x80000000)
 2143              	//    31:USBREGEN=USB voltage regulator enable (1)
 2144              	//    30:USBSSTBY=USB voltage regulator standby during stop, VLPS, LLS, and VLLS (0)
 2145              	//    29:USBVSTBY=USB voltage regulator standby during VLPS and VLLS (0)
 2146              	// 28-20:(reserved):read-only:000000000
 2147              	// 19-18:OSC32KSEL=32K oscillator clock select (00)
 2148              	//       (ERCLK32K for sLCD, RTC, and LPTMR)
 2149              	//                 00:System oscillator (OSC32KCLK)
 2150              	//                 01:(reserved)
 2151              	//                 10:RTC_CLKIN
 2152              	//                 11:LPO 1kHz
 2153              	//  17-6:(reserved):read-only:000000000000
 2154              	//   5-0:(reserved)
 2155              	.set SIM_SOPT1_OSC32KSEL_MASK   ,  0xC0000
 2156              	.set SIM_SOPT1_OSC32KSEL_SHIFT  ,  18
 2157              	// ---------------------------------------------------------------
 2158              	// SIM_SOPT2
 2159              	// 31-28:(reserved):read-only:0
 2160              	// 27-26:UART0SRC=UART0 clock source select
 2161              	//                00:clock disabled
 2162              	//                01:MCGFLLCLK
 2163              	//                10:OSCERCLK
 2164              	//                11:MCGIRCLK
 2165              	// 25-24:TPMSRC=TPM clock source select
 2166              	//              00:clock disabled
 2167              	//              01:MCGFLLCLK
 2168              	//              10:OSCERCLK
 2169              	//              11:MCGIRCLK
 2170              	// 23-19:(reserved):read-only:0
 2171              	// 15- 8:(reserved):read-only:0
 2172              	//  7- 5:CLKOUTSEL=CLKOUT select
 2173              	//                 000:(reserved)
 2174              	//                 001:(reserved)
 2175              	//                 010:bus clock
 2176              	//                 011:LPO clock (1 KHz)
 2177              	//                 100:MCGIRCLK
 2178              	//                 101:(reserved)
 2179              	//                 110:OSCERCLK
 2180              	//                 110:(reserved)
 2181              	//     4:RTCCLKOUTSEL=RTC clock out select
 2182              	//                    0:RTC (1 Hz)
 2183              	//                    1:OSCERCLK
 2184              	//  3- 0:(reserved):read-only:0
 2185              	.set SIM_SOPT2_UART0SRC_MASK       ,  0x0C000000
 2186              	.set SIM_SOPT2_UART0SRC_SHIFT      ,  26
 2187              	.set SIM_SOPT2_TPMSRC_MASK         ,  0x03000000
 2188              	.set SIM_SOPT2_TPMSRC_SHIFT        ,  24
 2189              	.set SIM_SOPT2_CLKOUTSEL_MASK      ,  0xE0
 2190              	.set SIM_SOPT2_CLKOUTSEL_SHIFT     ,  5
 2191              	.set SIM_SOPT2_RTCCLKOUTSEL_MASK   ,  0x10
 2192              	.set SIM_SOPT2_RTCCLKOUTSEL_SHIFT  ,  4
