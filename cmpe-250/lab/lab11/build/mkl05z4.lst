 2409              	//          write 1 to clear
 2410              	//    6:TOIE=timer overflow interrupt enable (0)
 2411              	//    5:CPWMS=center-aligned PWM select
 2412              	//            0:edge align (up count)
 2413              	//            1:center align (up-down count)
 2414              	//  4-3:CMOD=clock mode selection (00)
 2415              	//           00:counter disabled
 2416              	//           01:TPMx_CNT increments on every TPMx clock
 2417              	//           10:TPMx_CNT increments on rising edge of TPMx_EXTCLK
 2418              	//           11:(reserved)
 2419              	//  2-0:PS=prescale factor selection (000)
 2420              	//         can be written only when counter is disabled
 2421              	//         count clock = CMOD selected clock / 2^PS
 2422              	.set TPM_SC_DMA_MASK     , 0x100
 2423              	.set TPM_SC_DMA_SHIFT    , 8
 2424              	.set TPM_SC_TOF_MASK     , 0x80
 2425              	.set TPM_SC_TOF_SHIFT    , 7
